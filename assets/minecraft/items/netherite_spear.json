						{
							"when": "gui",
							"model": {
								"type": "minecraft:model",
								"model": "multipasta:item/godzilla/nes/pathos/hellbeast_icon"
							}
						}
					],
					"fallback": {
						"type": "minecraft:model",
						"model": "multipasta:item/godzilla/nes/pathos/hellbeast"
					}
				}
            }
        ],
        "fallback": {
			"type": "minecraft:select",
			"property": "minecraft:display_context",
			"cases": [
				{
					"when": ["gui", "ground", "fixed", "on_shelf"],
