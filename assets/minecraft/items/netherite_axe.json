{
    "oversized_in_gui": true,
    "model": {
        "type": "minecraft:select",
        "property": "minecraft:component",
        "component": "minecraft:custom_name",
        "cases": [
            {
                "when": [
                    "Banana Axe",
                    "Банановый топор"
                ],
				"model": {
					"type": "minecraft:select",
					"property": "minecraft:display_context",
					"cases": [
						{
							"when": "gui",
							"model": {
								"type": "minecraft:model",
								"model": "multipasta:item/godzilla/nes_replay/corona/banana_axe_icon"
							}
						}
					],
					"fallback": {
						"type": "minecraft:model",
						"model": "multipasta:item/godzilla/nes_replay/corona/banana_axe"
					}
				}
            },
            {
                "when": [
                    "Hoaxer's Fiddle",
                    "Скрипка Мистификатора"
                ],
				"model": {
					"type": "minecraft:select",
					"property": "minecraft:display_context",
					"cases": [
						{
							"when": "gui",
							"model": {
								"type": "minecraft:model",
								"model": "multipasta:item/lost/puppet_mouse/doodle_doodle_icon"
							}
						}
					],
					"fallback": {
						"type": "minecraft:select",
						"property": "minecraft:main_hand",
						"cases": [
							{
								"when": "left",
								"model": {
									"type": "minecraft:model",
									"model": "multipasta:item/lost/puppet_mouse/doodle_doodle_left"
								}
							}
						],
						"fallback": {
							"type": "minecraft:model",
							"model": "multipasta:item/lost/puppet_mouse/doodle_doodle"
						}
					}
				}
            },
            {
                "when": [
                    "Ruby Axe",
                    "Рубиновый топор"
                ],
                "model": {
                    "type": "minecraft:model",
                    "model": "multipasta:item/craft/ruby/netherite_axe"
                }
            },
            {
                "when": [
                    "Luther Axe",
                    "Якорный топор"
                ],
				"model": {
					"type": "minecraft:select",
					"property": "minecraft:display_context",
					"cases": [
						{
							"when": "gui",
							"model": {
								"type": "minecraft:model",
								"model": "multipasta:item/web_nd_analog/needlemouse/luther_axe_icon"
							}
						}
					],
					"fallback": {
						"type": "minecraft:model",
						"model": "multipasta:item/web_nd_analog/needlemouse/luther_axe"
					}
				}
            },
            {
                "when": [
                    "Digital Reef",
                    "Цифровой риф"
                ],
				"model": {
					"type": "minecraft:select",
					"property": "minecraft:display_context",
					"cases": [
						{
							"when": "gui",
							"model": {
								"type": "minecraft:model",
								"model": "multipasta:item/aesthetics/frutiger_umbrella/digital_reef_icon"
							}
						}
					],
					"fallback": {
						"type": "minecraft:model",
						"model": "multipasta:item/aesthetics/frutiger_umbrella/digital_reef"
					}
				}
            },
            {
                "when": [
                    "Synth Waveran",
                    "Кла-Варан"
                ],
				"model": {
					"type": "minecraft:select",
					"property": "minecraft:display_context",
					"cases": [
						{
							"when": "gui",
							"model": {
								"type": "minecraft:model",
								"model": "multipasta:item/godzilla/nes/trance/synth_waveran_icon"
							}
						}
					],
					"fallback": {
						"type": "minecraft:select",
						"property": "minecraft:main_hand",
						"cases": [
							{
								"when": "left",
								"model": {
									"type": "minecraft:model",
									"model": "multipasta:item/godzilla/nes/trance/synth_waveran_left"
								}
							}
						],
						"fallback": {
							"type": "minecraft:model",
							"model": "multipasta:item/godzilla/nes/trance/synth_waveran"
						}
					}
				}
            }
        ],
        "fallback": {
            "type": "minecraft:model",
            "model": "minecraft:item/netherite_axe"
        }
    }
}