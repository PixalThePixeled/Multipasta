{
    "oversized_in_gui": true,
    "model": {
        "type": "select",
        "property": "component",
        "component": "custom_name",
        "cases": [
			{
                "when": [
                    "Sixth Extinction",
                    "Шестое вымирание"
                ],
				"model": {
					"type": "minecraft:select",
					"property": "minecraft:display_context",
					"cases": [
						{
							"when": "gui",
							"model": {
								"type": "minecraft:model",
								"model": "multipasta:item/aesthetics/frutiger_umbrella/sixth_extinction_icon"
							}
						}
					],
					"fallback": {
						"type": "minecraft:model",
						"model": "multipasta:item/aesthetics/frutiger_umbrella/sixth_extinction"
					}
				}
            }
        ],
        "fallback": {
            "type": "minecraft:model",
            "model": "minecraft:item/mace"
        }
    }
}