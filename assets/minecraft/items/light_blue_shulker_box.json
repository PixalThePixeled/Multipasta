{
    "oversized_in_gui": true,
    "model": {
        "type": "select",
        "property": "component",
        "component": "custom_name",
        "cases": [
            {
                "when": [
                    "Fatbrine",
                    "Жиробрин"
                ],
                "model": {
                    "type": "model",
                    "model": "multipasta:item/craft/fatbrine"
                }
            },
            {
                "when": [
					"Pokeball",
					"Покебол"
                ],
				"model": {
					"type": "minecraft:select",
					"property": "minecraft:display_context",
					"cases": [
						{
							"when": "gui",
							"model": {
								"type": "minecraft:model",
								"model": "multipasta:item/pokepasta/pokeball/light_blue_icon"
							}
						}
					],
					"fallback": {
						"type": "minecraft:model",
						"model": "multipasta:item/pokepasta/pokeball/light_blue"
					}
				}
            }
        ],
        "fallback": {
            "type": "minecraft:special",
            "base": "minecraft:item/light_blue_shulker_box",
            "model": {
                "type": "minecraft:shulker_box",
                "texture": "minecraft:shulker_light_blue"
            }
        }
    }
}