{
    "model": {
        "type": "minecraft:select",
        "property": "minecraft:component",
        "component": "minecraft:custom_name",
        "cases": [
			{
                "when": [
					"Haunted Jigglypuff Eye",
					"Глаз Одeржимого Джигглипаффа"
                ],
				"model": {
					"type": "minecraft:select",
					"property": "minecraft:display_context",
					"cases": [
						{
							"when": "gui",
							"model": {
								"type": "minecraft:model",
								"model": "multipasta:item/pokepasta/haunted_jigglypuff/purin_eye_icon"
							}
						}
					],
					"fallback": {
						"type": "minecraft:model",
						"model": "multipasta:item/pokepasta/haunted_jigglypuff/purin_eye"
					}
				}
            }
        ],
        "fallback": {
            "type": "minecraft:select",
            "property": "minecraft:display_context",
            "cases": [
                {
                    "model": {
                        "type": "minecraft:model",
                        "model": "minecraft:item/spyglass"
                    },
                    "when": [
                        "gui",
                        "ground",
                        "fixed"
                    ]
                }
            ],
            "fallback": {
                "type": "minecraft:model",
                "model": "minecraft:item/spyglass_in_hand"
            }
        }
    }
}