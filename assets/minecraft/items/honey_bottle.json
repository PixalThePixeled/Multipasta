{
    "model": {
        "type": "minecraft:select",
        "property": "minecraft:component",
        "component": "minecraft:custom_name",
        "cases": [
            {
                "when": [
                    "Pepsi",
                    "Пепси"
                ],
                "model": {
                    "type": "minecraft:model",
                    "model": "multipasta:item/other/pepsi/pepsi"
                }
            },
            {
                "when": [
                    "Sighting Meat",
                    "Мистическое мясо"
                ],
                "model": {
                    "type": "minecraft:model",
                    "model": "multipasta:item/food/sighting_meat"
                }
            },
            {
                "when": [
                    "Parasite",
                    "Паразит"
                ],
                "model": {
                    "type": "minecraft:model",
                    "model": "multipasta:item/food/parasite"
                }
            }
        ],
        "fallback": {
            "type": "minecraft:model",
            "model": "minecraft:item/honey_bottle"
        }
    }
}