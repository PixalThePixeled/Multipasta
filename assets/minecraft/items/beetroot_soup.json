{
    "model": {
        "type": "minecraft:select",
        "property": "minecraft:component",
        "component": "minecraft:custom_name",
        "cases": [
            {
                "when": [
                    "Multipasta",
                    "Мультипаста"
                ],
                "model": {
                    "type": "minecraft:model",
                    "model": "multipasta:item/food/multipasta"
                }
            },
            {
                "when": [
                    "NES Godzilla Multipasta",
                    "НЕС Годзилла Мультипаста"
                ],
                "model": {
                    "type": "minecraft:model",
                    "model": "multipasta:item/food/nes_godzilla_multipasta"
                }
            },
            {
                "when": [
                    "Pokemon Stew",
                    "Рагу из покемонов"
                ],
                "model": {
                    "type": "minecraft:model",
                    "model": "multipasta:item/food/pokemon_stew"
                }
            }
        ],
        "fallback": {
            "type": "minecraft:model",
            "model": "minecraft:item/beetroot_soup"
        }
    }
}