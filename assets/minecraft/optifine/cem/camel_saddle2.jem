	"models": [
		{
			"part": "head",
			"id": "head",
			"invertAxis": "xy",
			"translate": [0, -23, 9],
			"animations": [
				{
					"body.tz": 10.5,
					"body_cancel.rx": "-body.rx",
					"body_cancel.ty": "-body.ty-16",
					"rotation.rz": "if(death_time > 0, -torad(min(sqrt((death_time - 1) / 20 * 1.6), 1) * 90), 0)",
					"var.limb_speed": "min(limb_speed, 0.35)",
					"var.limb_swing": "limb_swing",
					"var.death": "todeg(sin(torad(clamp(if(is_alive, var.death-0.1 * frame_time * 20, var.death+0.2 * frame_time * 20), 0, 1))))"
				},
				{
					"var.bodyRX": "body.rx-if(varb.is_dash, 0.08726646, 0)",
					"var.red_sit": "1-(body.ty-4)/19.9",
					"var.red_standup": "clamp(if(var.red_sit==0, var.red_standup-1, var.red_sit==1, var.red_standup+1, var.red_standup), 0, 1)",
					"varb.is_dash": "todeg(left_ear.ry)==-67.5",
					"var.dash": "clamp(if(varb.is_dash, 1, var.dash-0.2 * frame_time * 20), 0, 1)",
					"var.dash_swing": "clamp(if(varb.is_dash, var.dash_swing+0.04 * frame_time * 20, 0), 0, 1)",
					"var.red_death": "death_time/50",
					"var.red_deathsize": "todeg(sin(torad(clamp(abs(death_time/20-1), 0, 1))))",
					"red_head.rx": "torad(3) +torad(max(head_pitch,-20)) +sin(time/8+pi/3.5)/20",
					"red_head.ry": "torad(0) +torad(    head_yaw/2     )",
					"red_head.rz": "torad(0) +torad(    head_yaw/6     )",
					"red_head.ty": "-2.5 - sin((var.limb_swing+pi)/2)*var.limb_speed",
					"red_head_rot.rx": "lerp(var.red_sit, torad(3), 0) -var.bodyRX",
					"red_eyes_calm.visible": "!varb.is_dash",
					"red_eyes_angry.visible": "varb.is_dash",
					"red_body.ty": "-23.7 +pow(sin(time/16)/8, 4) +lerp(var.red_sit, 19, 0) -lerp(var.red_death, 0, 666)",
					"red_body.tz": "min(body.rx, 0)*30",
					"red_body.sx": "lerp(clamp(var.red_deathsize*4, 0, 1), 0, 1)",
					"red_body.sz": "red_body.sx",
					"red_body.sy": "red_body.sx",
					"red_body.rx": "-torad(head_pitch/4) -torad(5) +lerp(var.red_sit, torad(-5), 0) +pow(sin(time/16), 4)/lerp(var.red_sit, 12, 8)",
					"red_body.ry": " torad(head_yaw  /2)",
					"red_body2.rz": "sin((var.limb_swing+pi/4)/2)*var.limb_speed/6",
					"red_body_sit.rx": "var.bodyRX",
					"red_legs.rx": "torad(head_pitch/4) -pow(sin(time/16), 4)/lerp(var.red_sit, 12, 8)",
					"red_mouth2.sy": "hurt_time/10",
					"red_mouth3.ty": "hurt_time/10*13+1",
					"red_vocalsac.sx": "1 +pow(sin(time/16), 2)/7",
					"red_vocalsac.sz": "1 -pow(sin(time/16+pi/2), 2)/7",
					"red_vocalsac.sy": "1 +pow(sin(time/16+pi/2), 4)/7",
					"red_arm_left.ty": "+4.5 +lerp(var.red_sit, -5, 0)",
					"red_arm_left.tz": "-8.6 -(0.2 * hurt_time) +lerp(var.red_sit, -1, 0)",
					"red_arm_left.rx": "-(torad(7.5) * hurt_time) +torad(32) -sin(var.dash_swing*pi*1.5) +if(varb.is_dash, -1, 0) -sin(time/8+pi/3.5)/lerp(var.red_sit, 400, 20) +lerp(var.red_sit, torad(40), 0) ",
					"red_arm_left.ry": "+torad(16) -(torad(2) * hurt_time)+lerp(var.red_sit, torad(-25), 0)",
					"red_arm_left.rz": "-torad(16)",
					"red_arm_left2.tx": "+2.5",
					"red_arm_left2.ty": "+8 +(cos(time/0.5) * 0.1 * hurt_time)",
					"red_arm_left2.tz": "-0.3 -(0.1 * hurt_time)",
					"red_arm_left2.rx": "+(torad(7.5) * hurt_time) +torad(-42) +sin(var.dash_swing*pi)*2 +(sin(time/0.5) * torad(3.5) * hurt_time) -sin(time/8+pi/3.5)/lerp(var.red_sit, 30, 20) +lerp(var.red_sit, torad(55), 0)",
					"red_arm_left2.ry": "+torad(10)+lerp(var.red_sit, torad(55), +torad(0)) -sin(var.dash_swing*pi*1.5)*0.35 +if(varb.is_dash, -0.35, 0)",
					"red_arm_left2.rz": "+torad(10)+lerp(var.red_sit, torad(82.5), +torad(0))",
					"red_arm_right.ty": "red_arm_left.ty",
					"red_arm_right.tz": "red_arm_left.tz",
					"red_arm_right.rx": "red_arm_left.rx",
					"red_arm_right.ry": "-red_arm_left.ry",
					"red_arm_right.rz": "-red_arm_left.rz",
					"red_arm_right2.tx": "-red_arm_left2.tx",
					"red_arm_right2.ty": "+8 -(cos(time/0.5) * 0.1 * hurt_time)",
					"red_arm_right2.tz": "red_arm_left2.tz",
					"red_arm_right2.rx": "+(torad(7.5) * hurt_time) +torad(-42) +sin(var.dash_swing*pi)*2 -(sin(time/0.5) * torad(3.5) * hurt_time) -sin(time/8+pi/3.5)/lerp(var.red_sit, 30, 20) +lerp(var.red_sit, torad(55), 0)",
					"red_arm_right2.ry": "-red_arm_left2.ry",
					"red_arm_right2.rz": "-red_arm_left2.rz"
				},
				{
					"red_tail.tx": "       if(is_ridden,          0, lerp(var.red_sit,          cos(time/6)*2, 0))",
					"red_tail.rx": "       if(is_ridden, torad( 14), lerp(var.red_sit,              -torad(4), 0)) +torad(28) +if(is_ridden, -pow(sin(time/16), 4)/8, -pow(sin(time/8+pi/4),1)/12)",
					"red_tail.ry": "       if(is_ridden, torad(-36), lerp(var.red_sit,         cos(time/6)/2,  0))",
					"red_tail.rz": "        sin((var.limb_swing-pi/4)/2)*var.limb_speed/6",
					"red_tail_big.rx": "   if(is_ridden, torad( 22), lerp(var.red_sit,             -torad(16), 0)) +torad(32) -pow(sin(time/8+pi/4),1)/10 /if(is_ridden, 4, 1)",
					"red_tail_big.ry": "   if(is_ridden, torad(-53), lerp(var.red_sit, sin(time/6) *torad(36), 0))",
					"red_tail_big.rz": "  -sin((var.limb_swing-pi/8)/2)*var.limb_speed/4",
					"red_tail_medium.rx": "if(is_ridden, torad( 16), lerp(var.red_sit,             -torad(54), 0)) +torad(64) -pow(sin(time/8+pi/4),1) /8 /if(is_ridden, 4, 1)",
					"red_tail_medium.ry": "if(is_ridden, torad(-47), lerp(var.red_sit, sin(time/6) *torad(46), 0))",
					"red_tail_medium.rz": "-sin((var.limb_swing+pi/8)/2)*var.limb_speed/10",
					"red_tail_small.rx": " if(is_ridden, torad( 31), lerp(var.red_sit,             -torad(16), 0)) +torad(34) -pow(sin(time/8+pi/2),1) /8 /if(is_ridden, 4, 1)",
					"red_tail_small.ry": " if(is_ridden, torad(-39), lerp(var.red_sit, sin(time/6) *torad(38), 0))",
					"red_tail_small.rz": "  sin((var.limb_swing-pi/2)/2)*var.limb_speed/3"
				},
				{
					"red_backleg_left_rotation.rx": " torad(40) +sin(var.dash_swing*pi)/1.5 +pow(sin(time/16), 4)*lerp(var.red_sit, 0, 1)/12 +lerp(var.red_sit, +torad(56), 0)",
					"red_backleg_left_rotation.ry": "-torad(16) +lerp(var.red_sit, +torad(46), 0)",
					"red_backleg_left_rotation.rz": "-torad(66) +lerp(var.red_sit, +torad(62), 0)",
					"red_backleg_left.ty": "7 +var.bodyRX*8 +lerp(var.red_sit, -4, 0)",
					"red_backleg_left2.rz": "         torad(56) +lerp(var.red_sit, -torad(56), 0)",
					"red_backleg_right_rotation.rx": " red_backleg_left_rotation.rx",
					"red_backleg_right_rotation.ry": "-red_backleg_left_rotation.ry",
					"red_backleg_right_rotation.rz": "-red_backleg_left_rotation.rz",
					"red_backleg_right.ty": "red_backleg_left.ty",
					"red_backleg_right2.rz": "       -red_backleg_left2.rz"
				},
				{
					"red_frontleg_left_rotation.rx": "-torad(26) +sin(var.dash_swing*pi)*1.5 +sin(time/8+pi/3.5)*lerp(var.red_sit, 0, 1)/54 +lerp(pow(var.red_sit, if(var.red_standup==0, 0.5, 4)), +torad(-50), 0)",
					"red_frontleg_left_rotation.ry": " torad(16) +lerp(var.red_sit, +torad(-41), 0)",
					"red_frontleg_left_rotation.rz": "-torad(55) +lerp(var.red_sit, +torad( 50), 0)",
					"red_frontleg_left.ty": "7 +var.bodyRX*16 +lerp(var.red_sit, -4, 0)",
					"red_frontleg_left2.rz": "         torad(56) +lerp(var.red_sit, torad(-14), 0)",
					"red_frontleg_right_rotation.rx": " red_frontleg_left_rotation.rx",
					"red_frontleg_right_rotation.ry": "-red_frontleg_left_rotation.ry",
					"red_frontleg_right_rotation.rz": "-red_frontleg_left_rotation.rz",
					"red_frontleg_right.ty": "red_frontleg_left.ty",
					"red_frontleg_right2.rz": "        -red_frontleg_left2.rz"
				},
				{
					"red_frontleg_left.ry": "    -sin( var.limb_swing    /2)        *var.limb_speed*1.5",
					"red_frontleg_left.rz": " min(sin((var.limb_swing+pi)/2)+0.3, 0)*var.limb_speed*3  ",
					"red_frontleg_right.ry": "red_frontleg_left.ry",
					"red_frontleg_right.rz": "max(sin((var.limb_swing+pi)/2)-0.3, 0)*var.limb_speed*3  ",
					"red_backleg_left.ry": "-red_frontleg_right.ry",
					"red_backleg_left.rz": "-red_frontleg_right.rz",
					"red_backleg_right.ry": "-red_frontleg_left.ry",
					"red_backleg_right.rz": "-red_frontleg_left.rz"
				},
