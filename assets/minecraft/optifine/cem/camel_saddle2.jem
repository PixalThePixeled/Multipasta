					"red_leftwing.sz": "red_leftwing.sy",
					"red_leftwing.rx": "lerp(var.death, torad(-32) +sin(var.dash_swing*pi*0.75)/3  , torad(16) +pow(sin(time/8+pi), 2)/2)",
					"red_leftwing.ry": "lerp(var.death,        2.5 -sin(var.dash_swing*pi     )*2.6, torad(26) +pow(sin(time/8   ), 2)/2)",
