{
	"credit": "Model & Animations by Kotisimo, Not Hedorah & Horsebats textures by Moro2610, Hedorah texture by Shitov, NotVaran Keyano by Primal, Ghigan by PixalThePixeled",
	"textureSize": [128, 64],
	"texture": "textures/entity/multipasta/nothedorah/nothedorah.png",
	"models": [
		{
			"part": "head",
			"id": "head",
			"invertAxis": "xy",
			"translate": [0, -8, 0.5],
			"animations": [
				{
					"var.time": "time - pi/random(id)",
					"body.rx": 0,
					"body.tx": 0,
					"body.ty": 16.5,
					"body.tz": 0,
					"rotation.rz": "if(death_time > 0, -torad(min(sqrt((death_time - 1) / 20 * 1.6), 1) * 90), 0)",
					"varb.ifdance": "right_leg.rz!=0&&is_on_ground",
					"var.riding": "if(is_riding, 0, 1)",
					"var.death": "death_time"
				},
				{
					"var.nothedorah_ground": "todeg(sin(torad(clamp(if(is_on_ground && !is_on_shoulder, var.nothedorah_ground-0.15 * frame_time * 20, var.nothedorah_ground+0.07 * frame_time * 20), 0, 1))))",
					"var.nothedorah_sit": "   todeg(sin(torad(clamp(if(is_sitting, var.nothedorah_sit-0.08 * frame_time * 20, var.nothedorah_sit+0.09 * frame_time * 20), 0, 1))))",
					"var.nothedorah_sit2": "  todeg(sin(torad(clamp(if(is_sitting, var.nothedorah_sit2-0.3 * frame_time * 20, var.nothedorah_sit2+0.02 * frame_time * 20), 0, 1))))",
					"var.nothedorah_sit3": "  todeg(sin(torad(clamp(if(is_sitting, var.nothedorah_sit3-0.5 * frame_time * 20, var.nothedorah_sit3+0.04 * frame_time * 20), 0, 1))))",
					"var.dance": "            todeg(sin(torad(clamp(if(varb.ifdance, var.dance-0.15 * frame_time * 20, var.dance+0.15 * frame_time * 20), 0, 1))))",
					"var.dancearms": "        todeg(sin(torad(clamp(if(varb.ifdance, var.dancearms-0.04 * frame_time * 20, var.dancearms+0.2 * frame_time * 20), 0, 1))))",
					"var.dancealt": "         todeg(sin(torad(clamp(if(varb.ifdance, var.dancealt-0.025 * frame_time * 20, var.dancealt+0.25 * frame_time * 20), 0, 1))))",
					"var.horsebat1_appear": " todeg(sin(torad(clamp(if(is_on_ground && !is_on_shoulder, var.horsebat1_appear-0.085 * frame_time * 20, var.horsebat1_appear+0.16 * frame_time * 20), 0, 1))))",
					"var.horsebat2_appear": " todeg(sin(torad(clamp(if(is_on_ground && !(is_on_shoulder||varb.ifdance), var.horsebat2_appear-0.045 * frame_time * 20, var.horsebat2_appear+0.05 * frame_time * 20), 0, 1))))",
					"var.horsebat1_st": "     todeg(sin(torad(clamp(if(is_on_ground && !is_on_shoulder, var.horsebat1_st-0.09 * frame_time * 20, var.horsebat1_st+0.4 * frame_time * 20), 0, 1))))",
					"var.horsebat2_st": "     todeg(sin(torad(clamp(if(is_on_ground && !(is_on_shoulder||varb.ifdance), var.horsebat2_st-0.075 * frame_time * 20, var.horsebat2_st+0.4 * frame_time * 20), 0, 1))))",
					"var.horsebat_death": "   todeg(sin(torad(clamp(if(is_alive, var.horsebat_death-0.06 * frame_time * 20, var.horsebat_death+0.075 * frame_time * 20), 0, 1))))",
					"var.noth_riding": "      todeg(sin(torad(clamp(if(is_riding, var.noth_riding-0.08 * frame_time * 20, var.noth_riding+0.09 * frame_time * 20), 0, 1))))",
					"var.noth_riding2": "     todeg(sin(torad(clamp(if(is_riding, var.noth_riding2-0.03 * frame_time * 20, var.noth_riding2+0.4 * frame_time * 20), 0, 1))))"
				},
				{
					"horsebat.visible": "between(var.riding, 1, 1)",
					"horsebat.tx": "lerp(var.horsebat1_appear, -80, -2.5)",
					"horsebat.ty": "lerp(var.horsebat1_appear, -256, -16.5)",
					"horsebat.tz": "lerp(var.horsebat1_appear, 128, +8.5)",
					"horsebat.rx": "+torad(6)",
					"horsebat.ry": "+torad(6)",
					"horsebat.rz": "-torad(16)",
					"horsebat.sx": "lerp(var.horsebat1_st, 0, 1)",
					"horsebat.sy": "horsebat.sx",
					"horsebat.sz": "horsebat.sx",
					"horsebat_body_rotation.rx": "+torad(29) +(cos(var.time/4) * torad(6))",
					"horsebat_neck.rx": "-torad(8) -(cos(var.time/4) * torad(6)) ",
					"horsebat_neck.ry": "+torad(2) -(cos(var.time/4) * torad(6) +torad(head_yaw/4))",
					"horsebat_neck.rz": "-torad(14) -(cos(var.time/4) * torad(6) +torad(head_yaw/4))",
					"horsebat_skull.rx": "-torad(36) +(sin(var.time/4) * torad(4))",
					"horsebat_skull.ry": "+torad(2)",
					"horsebat_skull.rz": "+torad(12)",
					"horsebat_tail.rx": "-torad(22) +(sin(var.time/4) * torad(12))",
					"horsebat_tail.ry": "-torad(160)",
					"horsebat_tail.rz": "-(cos(var.time/4) * torad(12))",
					"horsebat_leftwing.rx": "-torad(32)",
					"horsebat_leftwing.ry": "+torad(84) -(cos(var.time/4) * torad(74))",
					"horsebat_leftwing.rz": "+torad(16) +(sin(var.time/4) * torad(16))",
					"horsebat_rightwing.rx": "-torad(32)",
					"horsebat_rightwing.ry": "-torad(84) +(cos(var.time/4) * torad(74))",
					"horsebat_rightwing.rz": "-horsebat_leftwing.rz"
				},
				{
					"horsebat_body.sx": "horsebat_body2.sx",
					"horsebat_body.sy": "horsebat_body2.sy",
					"horsebat_body.sz": "horsebat_body2.sz",
					"horsebat_body2.sx": "lerp(var.horsebat_death, 1, 0)",
					"horsebat_body2.sy": "horsebat_body2.sx",
					"horsebat_body2.sz": "horsebat_body2.sx",
					"horsebat_body2_alt.sx": "horsebat_body2.sx",
					"horsebat_body2_alt.sy": "horsebat_body2.sy",
					"horsebat_body2_alt.sz": "horsebat_body2.sz",
					"horsebat_neck2_rt.sx": "horsebat_body2.sx",
					"horsebat_neck2_rt.sy": "horsebat_body2.sy",
					"horsebat_neck2_rt.sz": "horsebat_body2.sz",
					"horsebat_neck2_alt_rt.sx": "horsebat_body2.sx",
					"horsebat_neck2_alt_rt.sy": "horsebat_body2.sy",
					"horsebat_neck2_alt_rt.sz": "horsebat_body2.sz"
				},
				{
					"horsebat_body2.visible": "between(var.dance, 0.9, 1) || between(var.dance, 0.4, 0.5) || between(var.dance, 0, 0.1)",
					"horsebat_body2_alt.visible": "between(var.dance, 0.6 ,0.8) || between(var.dance, 0.2, 0.3)",
					"horsebat_neck2_rt.visible": "horsebat_body2.visible",
					"horsebat_neck2_alt_rt.visible": "horsebat_body2_alt.visible"
				},
				{
					"horsebat2.visible": "between(var.riding, 1, 1)",
					"horsebat2.ry": "-rot_y +if(varb.ifdance, +(var.time/26), 0)",
					"horsebat_body_rotation2.tx": "lerp(var.horsebat2_appear, +80, +34.5) +lerp(var.dance, 14, 0)",
					"horsebat_body_rotation2.ty": "lerp(var.horsebat2_appear, -256, +12 -(sin(var.time/4) * 4)/1.5) +lerp(var.dance, -13, 0)",
					"horsebat_body_rotation2.tz": "lerp(var.horsebat2_appear, 30, +24)",
					"horsebat_body_rotation2.sx": "lerp(var.horsebat2_st, 0, 1)",
					"horsebat_body_rotation2.sy": "horsebat_body_rotation2.sx",
					"horsebat_body_rotation2.sz": "horsebat_body_rotation2.sx",
					"horsebat_body_rotation2.rx": "lerp(var.dance, torad(58), torad(29)) -(cos(var.time/4) * torad(6))",
					"horsebat_body_rotation2.ry": "lerp(var.dance, -torad(16), player_rot_y+pi)",
					"horsebat_neck2.rx": "lerp(var.dance, -torad(6), torad(18)) -(sin(var.time/4) * torad(8)) ",
					"horsebat_neck2.ry": "+torad(2) +(sin(var.time/4) * torad(6))",
					"horsebat_skull2.ty": "-7.8 +(var.death*3.4)",
					"horsebat_skull2.tz": "0 -(var.death*4.1)",
					"horsebat_skull2.rx": "lerp(var.dance, -torad(32), -torad(36)) -(sin(var.time/4) * torad(4))",
					"horsebat_tail2.rx": "lerp(var.dance, torad(50), -torad(18)) -(sin(var.time/4) * torad(12))",
					"horsebat_tail2.rz": "-(cos(var.time/4) * torad(12))",
					"horsebat_leftwing2.rx": "-torad(32)",
					"horsebat_leftwing2.ry": "+torad(84) +(cos(var.time/4) * torad(74))",
					"horsebat_leftwing2.rz": "+torad(16) -(sin(var.time/4) * torad(16))",
					"horsebat_rightwing2.rx": "-torad(32)",
					"horsebat_rightwing2.ry": "-torad(84) -(cos(var.time/4) * torad(74))",
					"horsebat_rightwing2.rz": "-horsebat_leftwing2.rz"
				},
				{
					"horsebat_tail2_alt.rx": "horsebat_tail2.rx",
					"horsebat_tail2_alt.rz": "horsebat_tail2.rz",
					"horsebat_leftwing2_alt.rx": "horsebat_leftwing2.rx",
					"horsebat_leftwing2_alt.ry": "horsebat_leftwing2.ry",
					"horsebat_leftwing2_alt.rz": "horsebat_leftwing2.rz",
					"horsebat_rightwing2_alt.rx": "horsebat_rightwing2.rx",
					"horsebat_rightwing2_alt.ry": "horsebat_rightwing2.ry",
					"horsebat_rightwing2_alt.rz": "-horsebat_leftwing2.rz"
				},
				{
					"var.alive": "if(is_alive, 0, 1)",
					"nothedorah_explosions.visible": "between(var.alive, 1, 1)",
					"nothedorah_explosions.ty": "-9",
					"nothedorah_explosions.rx": "-player_rot_x",
					"nothedorah_explosions.ry": "player_rot_y-rot_y+pi"
				},
				{
					"var.noalive": "if(!is_alive, 0, 1)",
					"nothedorah_eyes.visible": "between(var.noalive, 1, 1)",
					"var.floor": "floor(time / 3) % 7",
					"nothedorah_eyes1.visible": "var.floor == 0 || var.floor == 5 || var.floor == 6",
					"nothedorah_eyes2.visible": "var.floor == 1 || var.floor == 4",
					"nothedorah_eyes3.visible": "var.floor == 2 || var.floor == 3",
					"nothedorah_deatheyes.visible": "between(var.alive, 1, 1)"
				},
				{
					"nothedorah.rx": "         lerp(var.noth_riding, 0,                                              lerp(var.nothedorah_ground, 0 +lerp(var.nothedorah_sit, -torad(2), 0), -(cos(var.time/4) * torad(4)))   )",
					"nothedorah.ry": "         lerp(var.noth_riding, 0,                                              lerp(var.nothedorah_ground, +torad(head_yaw/6), +torad(head_yaw/4))   )",
					"nothedorah.rz": "         lerp(var.noth_riding, 0,                                              lerp(var.nothedorah_ground, 0, +(cos(var.time/4) * torad(2)))   )",
					"nothedorah_rotation.ty": "lerp(var.noth_riding, 2.2,                                            lerp(var.nothedorah_ground, +lerp(var.nothedorah_sit3, +2.5, +6.2), -20 +(sin(var.time/4) * 4)/2)   )",
					"nothedorah_rotation.tz": "lerp(var.noth_riding, -4,                                             if(is_on_shoulder, 22, 0) -2   )",
					"nothedorah_rotation.rx": "lerp(var.noth_riding, 0,                                              lerp(var.nothedorah_ground, 0, torad(6) -(torad(3) * hurt_time) +(sin(var.time/4) * torad(5)))   )"
				},
				{
					"nothedorah_head.tz": "lerp(var.noth_riding, 0,                     lerp(var.nothedorah_ground,  lerp(var.nothedorah_sit,  torad(head_yaw/6), 0 ), 0)   )",
					"nothedorah_head.rx": "lerp(var.noth_riding, +torad(14) +pow(sin(var.time/16+pi/2), 6)/12,       lerp(var.nothedorah_ground, -torad(20) +lerp(var.nothedorah_sit, +torad(36)  +(torad(2) * hurt_time) +torad(max(head_pitch,-60))/6,  +(torad(5) * hurt_time) +torad(max(head_pitch,-60))/6 +pow(sin(var.time/16+pi/4), 2)/6), +torad(6) -(sin(var.time/4) * torad(6)))   )",
					"nothedorah_head.ry": "lerp(var.noth_riding, 0 -sin(var.time/16) * torad(6),                     lerp(var.nothedorah_ground, 0 +lerp(var.nothedorah_sit, -torad(head_yaw/3.5) +(cos(var.time/8) * torad(6)), -torad(head_yaw/2) +cos(var.time/16) * torad(6) +(cos(limb_swing/2) * limb_speed)/4), 0 +torad(head_yaw/2))   )",
					"nothedorah_head.rz": "lerp(var.noth_riding, 0 -sin(var.time/16) * torad(8),                     lerp(var.nothedorah_ground, 0 +lerp(var.nothedorah_sit,  torad(head_yaw/6) +(sin(var.time/8) * torad(8)), +torad(head_yaw/1.8) -cos(var.time/16) * torad(6)), 0)   )",
					"nothedorah_jaw.rx": "lerp(var.noth_riding, 0,  +(torad(5) * hurt_time))",
					"nothedorah_neck.rx": "lerp(var.noth_riding, +torad(22) +pow(sin(var.time/16+pi/2), 2)/6,        lerp(var.nothedorah_ground, +torad(36) +lerp(var.nothedorah_sit, +torad(28)  -(torad(3) * hurt_time) +(sin(var.time/8) * torad(2)) +torad(max(head_pitch,-60))/6, +torad(max(head_pitch,-10))/6  -(torad(5) * hurt_time) +pow(sin(var.time/16+pi/4), 2)/6), +torad(56) -(cos(var.time/4) * torad(4)))   )",
					"nothedorah_neck.ry": "lerp(var.noth_riding, 0 -cos(var.time/16) * torad(6),                     lerp(var.nothedorah_ground, 0 +lerp(var.nothedorah_sit, 0 +torad(head_yaw/6) +(cos(var.time/8) * torad(5)), +torad(head_yaw/6) -(sin(limb_swing/2) * limb_speed)), -torad(head_yaw/10))   )",
					"nothedorah_neck.rz": "lerp(var.noth_riding, 0 +cos(var.time/16) * torad(6),                     lerp(var.nothedorah_ground, 0 +lerp(var.nothedorah_sit, 0 -torad(head_yaw/2) -(cos(var.time/8) * torad(5)), -torad(head_yaw/3.8) -cos(var.time/16) * torad(6)), 0)   )",
					"nothedorah_body_rotation.ty": "lerp(var.noth_riding, 0,                                         lerp(var.nothedorah_ground, -0 +lerp(var.nothedorah_sit, -1, 0), 0)   )",
					"nothedorah_body_rotation.tz": "lerp(var.noth_riding, 0,                                         lerp(var.nothedorah_ground, -0 +lerp(var.nothedorah_sit, -1, 0), 0)   )",
					"nothedorah_body_rotation.rx": "lerp(var.noth_riding, 0,                                         lerp(var.nothedorah_ground, -torad(8) +lerp(var.nothedorah_sit, -(torad(2) * hurt_time) -torad(max(head_pitch,-60))/6, 0), 0)   )",
					"nothedorah_body_rotation.ry": "lerp(var.noth_riding, 0,                                         lerp(var.nothedorah_ground, 0 +lerp(var.nothedorah_sit, 0 +(sin(var.time/8) * torad(8)), 0), 0)   )",
					"nothedorah_body_rotation.rz": "lerp(var.noth_riding, 0,                                         lerp(var.nothedorah_ground, 0 +lerp(var.nothedorah_sit, 0 +torad(head_yaw/3), 0), 0)   )",
					"nothedorah_body.rx": "lerp(var.noth_riding, -torad(26) -sin(var.time/8) * torad(4),             lerp(var.nothedorah_ground, -torad(11) +pow(sin(var.time/16+pi/2), 4)/6 +lerp(var.nothedorah_sit, -torad(56), 0 -(torad(3) * hurt_time)), -torad(36))   )",
					"nothedorah_body.ry": "lerp(var.noth_riding, 0,                                                  lerp(var.nothedorah_ground, 0 +lerp(var.nothedorah_sit, 0 +(sin(var.time/8) * torad(1)), 0 +(sin(limb_swing/2) * limb_speed)), 0)   )",
					"nothedorah_body.rz": "lerp(var.noth_riding, 0 -cos(var.time/16) * torad(2),                     lerp(var.nothedorah_ground, 0 +sin(var.time/16) * torad(4) +lerp(var.nothedorah_sit, 0 +(cos(var.time/8) * torad(1)), 0), 0)   )",
					"nothedorah_bodytail.tx": "lerp(var.noth_riding, 0,                                              lerp(var.nothedorah_ground, 0 +lerp(var.nothedorah_sit, -1 +(sin(var.time/8) * 1.2), 0), 0)   )",
					"nothedorah_bodytail.ty": "lerp(var.noth_riding, 1.5,                                            lerp(var.nothedorah_ground, +lerp(var.nothedorah_sit, -0.5, 1.5), -1)   )",
					"nothedorah_bodytail.tz": "lerp(var.noth_riding, 7,                                              lerp(var.nothedorah_ground, 6 +lerp(var.nothedorah_sit, 2.2, 0), 6)   )",
					"nothedorah_bodytail.rx": "lerp(var.noth_riding, +torad(46) +cos(var.time/8) * torad(4),         lerp(var.nothedorah_ground, 0 +(torad(5) * hurt_time) +lerp(var.nothedorah_sit, -torad(142), +torad(10.5) +pow(sin(var.time/16+pi/3), 4)/12), -torad(30) -(cos(var.time/4) * torad(6)))   )",
					"nothedorah_bodytail.ry": "lerp(var.noth_riding, 0,                                              lerp(var.nothedorah_ground, 0 +lerp(var.nothedorah_sit, +torad(65), -torad(head_yaw/7) -cos(var.time/16) * torad(12) +(cos(limb_swing/2) * limb_speed)), 0)   )",
					"nothedorah_bodytail.rz": "lerp(var.noth_riding2, 0,                                             lerp(var.nothedorah_ground, 0 +lerp(var.nothedorah_sit2, -torad(90) +torad(head_yaw/9), +sin(var.time/16) * torad(14)), 0 +cos(time/4) * hurt_time *torad(2))   )",
					"nothedorah_bodytail2.tz": "lerp(var.noth_riding, 13,                                            lerp(var.nothedorah_ground, 11 +lerp(var.nothedorah_sit, 2.2, 0), 12)   )",
					"nothedorah_bodytail2.rx": "lerp(var.noth_riding, +torad(54) +cos(var.time/8) * torad(4),        lerp(var.nothedorah_ground, -torad(6) +lerp(var.nothedorah_sit, -torad(120) +pow(sin(time/16), 4)/5, +pow(sin(var.time/16), 4)/6), -torad(51) -(cos(var.time/4) * torad(4)))   )",
					"nothedorah_bodytail2.ry": "lerp(var.noth_riding, 0,                                             lerp(var.nothedorah_ground, 0 +lerp(var.nothedorah_sit, -torad(6), -torad(head_yaw/5.5) -sin(var.time/16) * torad(14) -(sin(limb_swing/2) * limb_speed)*1.5), 0)   )",
					"nothedorah_bodytail2.rz": "lerp(var.noth_riding, 0,                                             lerp(var.nothedorah_ground, 0 +lerp(var.nothedorah_sit, +torad(8), -cos(var.time/16) * torad(14)), 0 +sin(time/4) * hurt_time *torad(2))   )",
					"nothedorah_bodytail3.rx": "lerp(var.noth_riding, +torad(34) +sin(var.time/8) * torad(6),        lerp(var.nothedorah_ground, +torad(32) +lerp(var.nothedorah_sit, -torad(125) +pow(cos(time/16+pi/4), 4)/4, -pow(sin(var.time/16+pi/2), 4)/4), -torad(58) -(cos(var.time/4) * torad(2)))   )",
					"nothedorah_bodytail3.ry": "lerp(var.noth_riding, 0,                                             lerp(var.nothedorah_ground, 0 +lerp(var.nothedorah_sit, -torad(26), -torad(head_yaw/4) -sin(var.time/16) * torad(12) -(sin(limb_swing/2) * limb_speed)*1.5), 0)   )",
					"nothedorah_bodytail3.rz": "lerp(var.noth_riding, 0,                                             lerp(var.nothedorah_ground, 0 +lerp(var.nothedorah_sit, +torad(6), -sin(var.time/16) * torad(8)), 0 +sin(time/4) * hurt_time *torad(2))   )",
					"nothedorah_bodytail4.rx": "lerp(var.noth_riding, -torad(85) +cos(var.time/8) * torad(12),       lerp(var.nothedorah_ground, -torad(40) +lerp(var.nothedorah_sit, -torad(76) +pow(sin(time/16), 4)/5, +pow(sin(var.time/16+pi/4), 4)/4), -torad(84) -(sin(var.time/4) * torad(6)))   )",
					"nothedorah_bodytail4.ry": "lerp(var.noth_riding, 0,                                             lerp(var.nothedorah_ground, 0 +lerp(var.nothedorah_sit, -torad(6), -torad(head_yaw/4) -sin(var.time/16) * torad(28) -(sin(limb_swing/2) * limb_speed)*1.5), 0)   )",
					"nothedorah_bodytail4.rz": "lerp(var.noth_riding, -torad(180),                                   lerp(var.nothedorah_ground, 0 +lerp(var.nothedorah_sit, +torad(36), -cos(var.time/16) * torad(8)), 0 -cos(time/4) * hurt_time *torad(4))   )"
				},
				{
					"nothedorah_leftshoulder.rx": "lerp(var.noth_riding, +torad(40) -pow(sin(var.time/16), 2)/5,     lerp(var.nothedorah_ground, +torad(16) +lerp(var.nothedorah_sit, +torad(18) -(cos(var.time/8) * torad(14)), -pow(sin(var.time/16+pi/2), 4)/4), +torad(41) +(cos(var.time/4) * torad(5)))   )",
