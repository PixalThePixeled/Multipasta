{
	"credit": "Model by kotisimo, Texture by moro2610, Animations by kotisimo and PixalThePixeled",
	"textureSize": [128, 128],
	"texture": "textures/entity/multipasta/red.png",
	"models": [
		{
			"part": "head",
			"id": "head",
			"invertAxis": "xy",
			"translate": [0, -8, 0.5],
			"animations": [
				{
					"body.rx": 0,
					"body.tx": 0,
					"body.ty": 16.5,
					"body.tz": 0,
					"rotation.rz": "if(death_time > 0, -torad(min(sqrt((death_time - 1) / 20 * 1.6), 1) * 90), 0)",
					"var.a": "0",
					"var.b": "torad(200)",
					"var.h": "if(health>3, -10000666, 0)",
					"var.damage": "+cos(time/0.26) * hurt_time *torad(26)",
					"var.fainted": "death_time * torad(116) +var.a",
					"var.eyescream": "-sin(time/0.3) * -torad(3)",
					"varb.ground": "is_on_ground || is_sitting || is_on_shoulder",
					"varb.sitting": "!is_sitting",
					"varb.alive": "!is_sitting",
					"var.limb_swing": "limb_swing*2.5",
					"var.limb_speed": "limb_speed"
				},
				{
					"var.red_stand": "todeg(sin(torad(clamp(if((is_on_ground || is_sitting) && !is_on_shoulder && is_alive, var.red_stand-0.1 * frame_time * 20, var.red_stand+0.2 * frame_time * 20), 0, 1))))",
					"var.red_sit": "  todeg(sin(torad(clamp(if(is_sitting && !is_on_shoulder, var.red_sit-0.1 * frame_time * 20, var.red_sit+0.1 * frame_time * 20), 0, 1))))",
					"var.red_shoulder": "todeg(sin(torad(clamp(if(is_on_shoulder, var.red_shoulder-0.04 * frame_time * 20, var.red_shoulder+0.085 * frame_time * 20), 0, 1))))",
					"var.red_death": "death_time/50",
					"var.red_deathsize": "todeg(sin(torad(clamp(abs(death_time/20-1), 0, 1))))",
					"red_head.rx": "lerp(var.red_stand, +torad(3) +torad(max(head_pitch,-20)) +pow(sin(time/8+pi/3.5),1)/20 +lerp(var.red_sit, +torad(0), +torad(0)), +torad(12) +torad(max(head_pitch,-20)) -pow(sin(time/8+pi/3.5),2)/8)",
					"red_head.ry": "lerp(var.red_stand, +torad(0) +torad(head_yaw/2) +lerp(var.red_sit, +torad(0), +torad(0)), +torad(0) +torad(head_yaw/2))",
					"red_head.rz": "lerp(var.red_stand, +torad(0) +torad(head_yaw/6) +lerp(var.red_sit, +torad(0), +torad(0)), +torad(0) +torad(head_yaw/4))",
					"red_head.ty": "-2.5 - lerp(var.red_stand, sin((var.limb_swing+pi)/2)*var.limb_speed, 0)",
					"red_body.ty": "lerp(var.red_stand, -23.7 +pow(sin(time/16), 4)/8 +lerp(var.red_sit, +5, 0), -18 +pow(sin(time/8+pi/3.5),4)*4) -lerp(var.red_shoulder, 16, 0) -lerp(var.red_death, 0, 666)",
					"red_body.tz": "lerp(var.red_shoulder, 32, 0)",
					"red_body.sx": "lerp(clamp(var.red_deathsize*4,0,1), 0, 1)",
					"red_body.sz": "red_body.sx",
					"red_body.sy": "red_body.sx",
					"red_body.rx": "lerp(var.red_stand, -torad(5) -torad(head_pitch/4) +pow(sin(time/16), 4)/8 +lerp(var.red_sit, +torad(0), +torad(0)), +torad(0) -torad(head_pitch/3) -pow(sin(time/8), 2)/6)",
					"red_body.ry": "lerp(var.red_stand, +torad(0) +torad(head_yaw/2) +lerp(var.red_sit, +torad(0), +torad(0)), +torad(0) +torad(head_yaw/2))",
					"red_body2.rz": "lerp(var.red_stand, sin((var.limb_swing+pi/4)/2)*var.limb_speed/6, 0)",
					"red_legs.rx": "lerp(var.red_stand, +torad(0) +torad(head_pitch/4) -pow(sin(time/16), 4)/8 +lerp(var.red_sit, +torad(0), +torad(0)), +torad(0))",
					"red_mouth2.sy": "hurt_time/10",
					"red_mouth3.ty": "hurt_time/10*13+1",
					"red_vocalsac.sx": "lerp(var.red_stand, +1 +pow(sin(time/16), 2)/7, +1 +pow(sin(time/8),2)/8)",
					"red_vocalsac.sz": "lerp(var.red_stand, +1 -pow(sin(time/16+pi/2), 2)/7, +1 -pow(sin(time/8+pi/3.5),2)/8)",
					"red_vocalsac.sy": "lerp(var.red_stand, +1 +pow(sin(time/16+pi/2), 4)/7, +1 +pow(sin(time/8+pi/3.5),2)/6)",
					"red_arm_left.ty": "+4.5",
					"red_arm_left.tz": "-8.6 -(0.2 * hurt_time)",
					"red_arm_left.rx": "-(torad(7.5) * hurt_time) +lerp(var.red_stand, +torad(32) -pow(sin(time/8+pi/3.5),1)/20 +lerp(var.red_sit, -torad(16), +torad(0)), +torad(32) +pow(sin(time/8+pi/3.5),2)/8)",
					"red_arm_left.ry": "+torad(16) -(torad(2) * hurt_time)",
					"red_arm_left.rz": "-torad(16)",
					"red_arm_left2.tx": "+2.5",
					"red_arm_left2.ty": "+8 +(cos(time/0.5) * 0.1 * hurt_time)",
					"red_arm_left2.tz": "-0.3 -(0.1 * hurt_time)",
					"red_arm_left2.rx": "+(torad(7.5) * hurt_time) +(sin(time/0.5) * torad(3.5) * hurt_time) +lerp(var.red_stand, -torad(42) -pow(sin(time/8+pi/3.5),1)/20 +lerp(var.red_sit, +torad(0), +torad(0)), -torad(36) +pow(sin(time/8+pi/3.5),2)/6)",
					"red_arm_left2.ry": "+torad(10)",
					"red_arm_left2.rz": "+torad(10)",
					"red_arm_right.ty": "red_arm_left.ty",
					"red_arm_right.tz": "red_arm_left.tz",
					"red_arm_right.rx": "red_arm_left.rx",
					"red_arm_right.ry": "-red_arm_left.ry",
					"red_arm_right.rz": "-red_arm_left.rz",
					"red_arm_right2.tx": "-red_arm_left2.tx",
					"red_arm_right2.ty": "+8 -(cos(time/0.5) * 0.1 * hurt_time)",
					"red_arm_right2.tz": "red_arm_left2.tz",
					"red_arm_right2.rx": "+(torad(7.5) * hurt_time) -(sin(time/0.5) * torad(3.5) * hurt_time) +lerp(var.red_stand, -torad(42) -pow(sin(time/8+pi/3.5),1)/20 +lerp(var.red_sit, +torad(0), +torad(0)), -torad(36) +pow(sin(time/8+pi/3.5),2)/6)",
					"red_arm_right2.ry": "-red_arm_left2.ry",
					"red_arm_right2.rz": "-red_arm_left2.rz"
				},
				{
					"red_tail.tx": "lerp(var.red_stand, +torad(0) +lerp(var.red_sit, -torad(0) +cos(time/6) * 2, +torad(0)), +torad(0))",
					"red_tail.rx": "lerp(var.red_stand, +torad(28) -pow(sin(time/8+pi/4),1)/12 +lerp(var.red_sit, -torad(4), +torad(0)), -torad(26) -pow(sin(time/8+pi/3.5),2)/4)",
					"red_tail.ry": "lerp(var.red_stand, +torad(0) +lerp(var.red_sit, -torad(0) +cos(time/6) * torad(32), +torad(0)), +torad(0))",
					"red_tail.rz": "lerp(var.red_stand, sin((var.limb_swing-pi/4)/2)*var.limb_speed/6, 0)",
					"red_tail_big.rx": "lerp(var.red_stand, +torad(32)  -pow(sin(time/8+pi/4),1)/10 +lerp(var.red_sit, -torad(16), +torad(0)), +torad(36) +pow(sin(time/8),2)/4)",
					"red_tail_big.ry": "lerp(var.red_stand, +torad(0) +lerp(var.red_sit, -torad(0) +sin(time/6) * torad(36), +torad(0)), +torad(0))",
					"red_tail_big.rz": "lerp(var.red_stand, -sin((var.limb_swing-pi/8)/2)*var.limb_speed/4, 0)",
					"red_tail_medium.rx": "lerp(var.red_stand, +torad(64)  -pow(sin(time/8+pi/4),1)/8 +lerp(var.red_sit, -torad(54), +torad(0)), +torad(48) +pow(sin(time/8+pi/3.5),2)/2)",
					"red_tail_medium.ry": "lerp(var.red_stand, +torad(0) +lerp(var.red_sit, -torad(0) +sin(time/6) * torad(46), +torad(0)), +torad(0))",
					"red_tail_medium.rz": "lerp(var.red_stand, -sin((var.limb_swing+pi/8)/2)*var.limb_speed/10, 0)",
					"red_tail_small.rx": "lerp(var.red_stand, +torad(34)  -pow(sin(time/8+pi/2),1)/8 +lerp(var.red_sit, -torad(16), +torad(0)), +torad(38) +pow(sin(time/8),4)/2)",
					"red_tail_small.ry": "lerp(var.red_stand, +torad(0) +lerp(var.red_sit, -torad(0) +sin(time/6) * torad(38), +torad(0)), +torad(0))",
					"red_tail_small.rz": "lerp(var.red_stand, sin((var.limb_swing-pi/2)/2)*var.limb_speed/3, 0)"
				},
				{
					"red_backleg_left_rotation.rx": "lerp(var.red_stand, +torad(40) +pow(sin(time/16), 4)/12 +lerp(var.red_sit, +torad(0), +torad(0)), +torad(16) +pow(sin(time/8+pi/3.5),2)/4)",
					"red_backleg_left_rotation.ry": "lerp(var.red_stand, -torad(16) +lerp(var.red_sit, -torad(16), +torad(0)), -torad(34))",
					"red_backleg_left_rotation.rz": "lerp(var.red_stand, -torad(66) +lerp(var.red_sit, +torad(12), +torad(0)), -torad(16))",
					"red_backleg_left2.rz": "lerp(var.red_stand, +torad(56) +lerp(var.red_sit, -torad(66), +torad(0)), +torad(64) -pow(sin(time/8),2)/4)",
					"red_backleg_right_rotation.rx": "+red_backleg_left_rotation.rx",
					"red_backleg_right_rotation.ry": "-red_backleg_left_rotation.ry",
					"red_backleg_right_rotation.rz": "-red_backleg_left_rotation.rz",
					"red_backleg_right2.rz": "-lerp(var.red_stand, +torad(56) +lerp(var.red_sit, -torad(66), +torad(0)), +torad(64) -pow(sin(time/8),2)/4)"
				},
				{
					"red_frontleg_left_rotation.rx": "lerp(var.red_stand, -torad(26) +pow(sin(time/8+pi/3.5),1)/54 +lerp(var.red_sit, +torad(0), +torad(0)), -torad(16) +pow(sin(time/8+pi/3.5),2)/4)",
					"red_frontleg_left_rotation.ry": "lerp(var.red_stand, +torad(16) +lerp(var.red_sit, +torad(16), +torad(0)), +torad(56))",
					"red_frontleg_left_rotation.rz": "lerp(var.red_stand, -torad(55) +lerp(var.red_sit, +torad(12), +torad(0)), -torad(24))",
					"red_frontleg_left2.rz": "lerp(var.red_stand, +torad(56) +lerp(var.red_sit, -torad(64), +torad(0)), +torad(54) +pow(sin(time/8),2)/4)",
					"red_frontleg_right_rotation.rx": "+red_frontleg_left_rotation.rx",
					"red_frontleg_right_rotation.ry": "-red_frontleg_left_rotation.ry",
					"red_frontleg_right_rotation.rz": "-red_frontleg_left_rotation.rz",
					"red_frontleg_right2.rz": "-lerp(var.red_stand, +torad(56) +lerp(var.red_sit, -torad(64), +torad(0)), +torad(54) +pow(sin(time/8),2)/4)"
				},
				{
					"red_frontleg_left.ry": "lerp(var.red_stand, -sin(var.limb_swing/2)*var.limb_speed*1.5, 0)",
					"red_frontleg_left.rz": "lerp(var.red_stand, min(sin((var.limb_swing+pi)/2)+0.3,0)*var.limb_speed*1.5, 0)",
					"red_frontleg_right.ry": "red_frontleg_left.ry",
					"red_frontleg_right.rz": "lerp(var.red_stand, max(sin((var.limb_swing+pi)/2)-0.3,0)*var.limb_speed*1.5, 0)",
					"red_backleg_left.ry": "-red_frontleg_right.ry",
					"red_backleg_left.rz": "-red_frontleg_right.rz",
					"red_backleg_right.ry": "-red_frontleg_left.ry",
					"red_backleg_right.rz": "-red_frontleg_left.rz"
				},
				{
					"red_frontleg_left_step0.visible": "between(red_frontleg_left.ry, -1, 0.125)",
					"red_frontleg_left_step1.visible": "between(red_frontleg_left.ry, 0.125, 0.375)",
					"red_frontleg_left_step2.visible": "between(red_frontleg_left.ry, 0.375, 1)",
					"red_frontleg_right_step0.visible": "between(red_frontleg_right.ry, -0.125, 1)",
					"red_frontleg_right_step1.visible": "between(red_frontleg_right.ry, -0.375, -0.125)",
					"red_frontleg_right_step2.visible": "between(red_frontleg_right.ry, -1, -0.375)",
					"red_backleg_left_step0.visible": "between(red_backleg_left.ry, -0.125, 1)",
					"red_backleg_left_step1.visible": "between(red_backleg_left.ry, -0.375, -0.125)",
					"red_backleg_left_step2.visible": "between(red_backleg_left.ry, -1, -0.375)",
					"red_backleg_right_step0.visible": "between(red_backleg_right.ry, -1, 0.125)",
					"red_backleg_right_step1.visible": "between(red_backleg_right.ry, 0.125, 0.375)",
					"red_backleg_right_step2.visible": "between(red_backleg_right.ry, 0.375, 1)"
				},
				{
					"red_leftwing.sy": "lerp(var.red_stand, 0, +1)",
					"red_leftwing.rx": "lerp(var.red_stand, 0, +torad(16) +pow(sin(time/8+pi),2)/2)",
					"red_leftwing.ry": "lerp(var.red_stand, 0, +torad(26) +pow(sin(time/8), 2)/2)",
					"red_leftwing.rz": "lerp(var.red_stand, 0, +torad(16) +pow(sin(time/8), 2)*2)",
					"red_rightwing.sy": "red_leftwing.sy",
					"red_rightwing.rx": "red_leftwing.rx",
					"red_rightwing.ry": "-red_leftwing.ry",
					"red_rightwing.rz": "-red_leftwing.rz"
				},
				{
					"notmoguera_mk2_explosions.rx": "-player_rot_x",
					"notmoguera_mk2_explosions.ry": "player_rot_y-rot_y+pi",
					"var.notmoguera_mk2_deathsize": "todeg(sin(torad(clamp(if(is_alive, var.notmoguera_mk2_deathsize-0.12 * frame_time * 20, var.notmoguera_mk2_deathsize+0.12 * frame_time * 20), 0, 1))))",
					"notmoguera_mk2_body.sx": "lerp(var.notmoguera_mk2_deathsize, 0, 1)",
					"notmoguera_mk2_body.sy": "pow(notmoguera_mk2_body.sx, 4)",
					"notmoguera_mk2_body.sz": "lerp(var.notmoguera_mk2_deathsize, 0, 1)",
					"notmoguera_mk2_explosions.sx": "lerp(var.notmoguera_mk2_deathsize, 0, 1)",
					"notmoguera_mk2_explosions.sy": "pow(notmoguera_mk2_body.sx, 4)",
					"notmoguera_mk2_explosions.sz": "lerp(var.notmoguera_mk2_deathsize, 0, 1)",
