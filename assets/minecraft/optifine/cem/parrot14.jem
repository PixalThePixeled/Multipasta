					"notmoguera_mk2_body.ty": "lerp(var.notmogueramk2_appearance, -124, -18 -(1.5 * hurt_time) +(sin(var.time/1.5) * 1 * hurt_time))",
					"notmoguera_mk2_body.sy": "lerp(var.notmogueramk2_size, 0, 1)",
					"notmoguera_mk2_body.sz": "lerp(var.notmogueramk2_size, 0, 1)",
					"notmoguera_mk2_head.rx": "lerp(var.notmogueramk2_appearance, 0, +torad(6))",
					"notmoguera_mk2_head.ry": "lerp(var.notmogueramk2_appearance, 0, -torad(6)  +torad(head_yaw/4))",
					"notmoguera_mk2_body.rx": "lerp(var.notmogueramk2_appearance, 0, -torad(6))",
					"notmoguera_mk2_body.ry": "lerp(var.notmogueramk2_appearance, 0, +torad(head_yaw/3))",
					"notmoguera_mk2_tentacle_frontleft.ry": "lerp(var.notmogueramk2_appearlegs, 0, -torad(38))",
					"notmoguera_mk2_tentacle_frontleft.rx": "lerp(var.notmogueramk2_appearlegs, -torad(71),  -torad(21) +pow(sin(var.time/16+pi/6),2)/14) -(torad(5) * hurt_time) +(cos(var.time/0.5) * torad(5) * hurt_time)",
					"notmoguera_mk2_tentacle_frontright.ry": "-notmoguera_mk2_tentacle_frontleft.ry",
					"notmoguera_mk2_tentacle_frontright.rx": "lerp(var.notmogueramk2_appearlegs, -torad(71),  -torad(21) +pow(sin(var.time/16+pi/6),2)/14) -(torad(5) * hurt_time) +(cos(var.time/0.5) * torad(5) * hurt_time)",
					"notmoguera_mk2_tentacle_backleft.ry": "-notmoguera_mk2_tentacle_frontleft.ry",
					"notmoguera_mk2_tentacle_backleft.rx": "-lerp(var.notmogueramk2_appearlegs, -torad(71),  -torad(21) +pow(sin(var.time/16+pi/6),2)/14) +(torad(5) * hurt_time) +(cos(var.time/0.5) * torad(5) * hurt_time)",
					"notmoguera_mk2_tentacle_backright.ry": "notmoguera_mk2_tentacle_frontleft.ry",
					"notmoguera_mk2_tentacle_backright.rx": "-lerp(var.notmogueramk2_appearlegs, -torad(71),  -torad(21) +pow(sin(var.time/16+pi/6),2)/14) +(torad(5) * hurt_time) +(cos(var.time/0.5) * torad(5) * hurt_time)"
				},
				{
