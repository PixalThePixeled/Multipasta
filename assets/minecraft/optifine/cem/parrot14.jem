				{
					"var.orga_riding": "  todeg(sin(torad(clamp(if(is_riding, var.orga_riding-0.09 * frame_time * 20, var.orga_riding+0.08 * frame_time * 20), 0, 1))))",
					"var.orga_riding2": "  todeg(sin(torad(clamp(if(is_riding, var.orga_riding2-0.2 * frame_time * 20, var.orga_riding2+0.35 * frame_time * 20), 0, 1))))",
