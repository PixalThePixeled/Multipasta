					"notmoguera_classic_body.sz": "lerp(var.notmoguera_classic_size, 0, 1)",
					"notmoguera_classic_body.tx": "lerp(var.notmogueras_appearance_alt, -144, -54 +if(health<=3, 0 -pow(sin(var.time/8+pi/2),7)*12, 0) )",
					"notmoguera_classic_body.ty": "lerp(var.notmogueras_appearance_alt, -260, -77 +cos(var.time/8) * 4 +if(health<=3, 0 -pow(sin(var.time/8+pi/3),6)*14, 0) +(var.death*4 +12.5) )",
					"notmoguera_classic_body.tz": "lerp(var.notmogueras_appearance_alt, 0, 2 +if(health<=3, 0 -pow(sin(var.time/4+pi/3),7)*12, 0) )",
					"notmoguera_classic_body.ry": "player_rot_y+pi +if(health<=3, -pow(sin(var.time/2+pi/3),7)/6, 0 )",
					"notmoguera_classic_body.rz": "lerp(var.notmogueras_appearance, -torad(16) -sin(var.time/1) * torad(3), +sin(var.time/2) * torad(1))",
					"notmoguera_classic_head.rx": "lerp(var.notmogueras_appearance, -torad(36), +torad(10) +sin(var.time/8) * torad(6))",
					"notmoguera_classic_head.rz": "lerp(var.notmogueras_appearance, -torad(16), +if(health<=3, -torad(18) -pow(sin(var.time/1+pi/2),6)/2.5, -cos(var.time/8) * torad(4) ) )",
					"notmoguera_classic_hand_left.ty": "(var.death*5 +12.5) -18",
