					"notmoguera_classic_tentacle_left.ry": "lerp(var.notmogueras_appearance, +torad(28) -cos(var.time/1) * torad(28), +torad(22) -cos(var.time/8) * torad(26))",
					"notmoguera_classic_tentacle_left.rz": "lerp(var.notmogueras_appearance, -torad(48) +sin(var.time/1) * torad(18), +if(health<=3, -torad(54) +pow(sin(var.time/8+pi/3),6)*1.2, -torad(30) +sin(var.time/8) * torad(16) ) )",
