{
	"credit": "Model & Animations by Kotisimo, Orga texture by Primal, Fetal/Classic NotMoguera texture by PixalThePixeled, Iuri NotMoguera texture by Kotisimo & Sp0ty (Formerly)",
	"textureSize": [256, 128],
	"texture": "textures/entity/multipasta/orga/orga.png",
	"models": [
		{
			"part": "head",
			"id": "head",
			"invertAxis": "xy",
			"translate": [0, -8, 0.5],
			"animations": [
				{
					"var.time": "time - pi/random(id)",
					"body.rx": 0,
					"body.tx": 0,
					"body.ty": 16.5,
					"body.tz": 0,
					"rotation.rz": "if(death_time > 0, -torad(min(sqrt((death_time - 1) / 20 * 1.6), 1) * 90), 0)",
					"rotation.tz": "-4",
					"var.notmogueramk2_size": "  todeg(sin(torad(clamp(if((is_on_ground||is_riding) && !is_on_shoulder, var.notmogueramk2_size-0.08 * frame_time * 20, var.notmogueramk2_size+0.3 * frame_time * 20), 0, 1))))",
					"var.notmogueramk2_appearance": "  todeg(sin(torad(clamp(if((is_on_ground||is_riding) && !is_on_shoulder, var.notmogueramk2_appearance-0.09 * frame_time * 20, var.notmogueramk2_appearance+0.2 * frame_time * 20), 0, 1))))",
					"var.notmogueramk2_appearlegs": "  todeg(sin(torad(clamp(if((is_on_ground||is_riding) && !is_on_shoulder, var.notmogueramk2_appearlegs-0.25 * frame_time * 20, var.notmogueramk2_appearlegs+0.13 * frame_time * 20), 0, 1))))",
					"var.notmogueramk2_nd_orga_fly": "  todeg(sin(torad(clamp(if(is_on_ground && !is_on_shoulder, var.notmogueramk2_nd_orga_fly-0.15 * frame_time * 20, var.notmogueramk2_nd_orga_fly+0.02 * frame_time * 20), 0, 1))))",
					"var.notmoguera_iuri_size": "  todeg(sin(torad(clamp(if((is_on_ground||is_riding) && !is_on_shoulder, var.notmoguera_iuri_size-0.035 * frame_time * 20, var.notmoguera_iuri_size+0.3 * frame_time * 20), 0, 1))))",
					"var.notmoguera_iuri_appearance": "  todeg(sin(torad(clamp(if((is_on_ground||is_riding) && !is_on_shoulder, var.notmoguera_iuri_appearance-0.032 * frame_time * 20, var.notmoguera_iuri_appearance+0.025 * frame_time * 20), 0, 1))))",
					"var.notmoguera_classic_size": "  todeg(sin(torad(clamp(if((is_on_ground||is_riding) && !is_on_shoulder, var.notmoguera_classic_size-0.05 * frame_time * 20, var.notmoguera_classic_size+0.3 * frame_time * 20), 0, 1))))",
					"var.notmogueras_appearance": "  todeg(sin(torad(clamp(if((is_on_ground||is_riding) && !is_on_shoulder, var.notmogueras_appearance-0.3 * frame_time * 20, var.notmogueras_appearance+0.1 * frame_time * 20), 0, 1))))",
					"var.notmogueras_appearance_alt": "  todeg(sin(torad(clamp(if((is_on_ground||is_riding) && !is_on_shoulder, var.notmogueras_appearance_alt-0.055 * frame_time * 20, var.notmogueras_appearance_alt+0.02 * frame_time * 20), 0, 1))))",
					"var.fetal_size": "  todeg(sin(torad(clamp(if((is_on_ground||is_riding) && !is_on_shoulder, var.fetal_size-0.07 * frame_time * 20, var.fetal_size+0.25 * frame_time * 20), 0, 1))))",
					"var.fetal_appear": "  todeg(sin(torad(clamp(if((is_on_ground||is_riding) && !is_on_shoulder, var.fetal_appear-0.08 * frame_time * 20, var.fetal_appear+0.027 * frame_time * 20), 0, 1))))",
					"var.riding": "if(is_riding, 0, 1)",
					"var.death": "death_time"
				},
				{
					"notmoguera_mk2_body.visible": "between(var.riding, 1, 1)",
					"notmoguera_mk2.ty": "lerp(var.orga_riding, -22.5,      lerp(var.notmogueramk2_nd_orga_fly, -22.5 , -30 +sin(var.time/8) * 2 +lerp(var.orga_shoulder, -4, +4))    )",
					"notmoguera_mk2.tz": "lerp(var.orga_riding, 3,      lerp(var.orga_shoulder, 28, 3)    )",
					"notmoguera_mk2.rz": "lerp(var.orga_riding, 0,      lerp(var.notmogueramk2_nd_orga_fly, 0, 0 -cos(var.time/8) * torad(8) )    )",
					"var.chainsaw": "if(health<=5, 0, 1)",
					"var.floor": "floor(time / 2) % 2",
