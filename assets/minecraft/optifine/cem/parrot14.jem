					"notmoguera_classic_tail.rz": "lerp(var.notmogueras_appearance, -cos(var.time/1) * torad(38), +if(health<=3, +cos(var.time/1.2) * torad(34) +pow(sin(var.time/8+pi/3),7)/1.2, -cos(var.time/2) * torad(24)))",
					"notmoguera_classic_fin.ty": "(var.death*6 +12.5) -3",
					"notmoguera_classic_fin.rx": "lerp(var.notmogueras_appearance, -torad(48) , -torad(58))",
					"notmoguera_classic_fin.rz": "lerp(var.notmogueras_appearance, -sin(var.time/1) * torad(46), +if(health<=3, +sin(var.time/1.2) * torad(36), -sin(var.time/2) * torad(26)))"
				},
				{
					"notmoguera_iuri_rotation.visible": "between(var.riding, 1, 1)",
