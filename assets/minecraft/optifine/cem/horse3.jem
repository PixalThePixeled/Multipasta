{
	"credit": "Texture by Sp0ty, Model by Kotisimo, Animations by Kotisimo & PixalThePixeled",
	"textureSize": [128, 64],
	"texture": "textures/entity/multipasta/doomer_ponypuff/pojhgjkjhghjh.png",
	"models": [
		{
			"part": "head",
			"id": "head",
			"invertAxis": "xy",
			"translate": [0, -22, 9],
			"animations": [
				{
					"var.time": "time - pi/random(id)",
					"body.rx": 0,
					"body.tx": -0.5,
					"body.ty": 11,
					"body.tz": -2,
					"rotation.rz": "if(death_time > 0, -torad(min(sqrt((death_time - 1) / 20 * 1.6), 1) * 90), 0)",
					"rotation.ty": "lerp(var.ponypuff_water, 0, +sin(time/7.5) *(1-var.ponypuff_rid) -1*var.ponypuff_rid)",
					"var.ponypuff_water": "  todeg(sin(torad(clamp(if(is_in_water, var.ponypuff_water+0.1   * frame_time * 20, var.ponypuff_water-0.3   * frame_time * 20), 0, 1))))",
					"var.doomerpuff_water": "todeg(sin(torad(clamp(if(is_in_water, var.doomerpuff_water+0.2 * frame_time * 20, var.doomerpuff_water-0.3 * frame_time * 20), 0, 1))))",
					"var.ponypuff_rid": "    todeg(sin(torad(clamp(if(is_ridden,   var.ponypuff_rid+0.2     * frame_time * 20, var.ponypuff_rid-0.06    * frame_time * 20), 0, 1))))",
					"var.doomerpuff_st": "   todeg(sin(torad(clamp(if(is_in_water, var.doomerpuff_st+0.1    * frame_time * 20, var.doomerpuff_st-0.2    * frame_time * 20), 0, 1))))",
					"var.ingui": "if(is_in_gui, 0, 1)",
					"var.eat": "max(neck.ty - 4, 0)/7",
					"var.inhale": "clamp(if(var.eat==0, var.inhale -0.04* frame_time * 20, var.inhale +0.015 * frame_time * 20), 0, 1)",
					"var.inhale2": "max(var.inhale-0.75, 0)*4",
					"var.smoke": "min(if(var.eat==0, var.smoke+0.1 * frame_time * 20, 0), 8)",
					"var.damage": "hurt_time/0.25",
					"var.fainted": "death_time",
					"var.jump": "-min(neck.ty-4, 0)/8",
					"var.swj": "1-var.jump",
					"render.leash_offset_x": "0",
					"render.leash_offset_y": "-9/16 -lerp(var.ponypuff_water, +lerp(var.ponypuff_rid, 0, -9), 0)/16",
					"render.leash_offset_z": "0",
					"render.shadow_size": "0.55",
					"render.shadow_opacity": "lerp(var.ponypuff_water, +lerp(var.ponypuff_rid, 1, 0.75), 1)",
					"render.shadow_offset_x": "2/16 *-sin(rot_y)",
					"render.shadow_offset_z": "2/16 * cos(rot_y)"
				},
				{
					"pony_doomerpuff_head.sx": "1+var.inhale/3",
					"pony_doomerpuff_head.sy": "pony_doomerpuff_head.sx",
					"pony_doomerpuff_head.sz": "1-var.inhale/4",
					"pony_doomerpuff_head1.visible": "between(var.inhale, 0, 0.25)",
					"pony_doomerpuff_head2.visible": "between(var.inhale, 0.25, 0.75)",
					"pony_doomerpuff_head3.visible": "between(var.inhale, 0.75, 1)",
					"pony_doomerpuff_cube1.visible": "pony_doomerpuff_head1.visible",
					"pony_doomerpuff_cube2.visible": "pony_doomerpuff_head2.visible",
					"pony_doomerpuff_cube3.visible": "pony_doomerpuff_head3.visible",
					"pony_doomerpuff_smoke1.rx": "if(is_in_gui, 0, -player_rot_x)",
					"pony_doomerpuff_smoke1.ry": "if(is_in_gui, 0, player_rot_y-rot_y+pi)",
					"pony_doomerpuff_smoke1.ty": "-var.smoke*3",
					"pony_doomerpuff_smoke1.tz": "-var.smoke*2",
					"pony_doomerpuff_smoke1.visible": "between(var.smoke, 0.015, 6)",
					"pony_doomerpuff_smoke2.rx": "pony_doomerpuff_smoke1.rx",
					"pony_doomerpuff_smoke2.ry": "pony_doomerpuff_smoke1.ry",
					"pony_doomerpuff_smoke2.tx": "-var.smoke/2",
					"pony_doomerpuff_smoke2.ty": "-var.smoke*1",
					"pony_doomerpuff_smoke2.tz": "-var.smoke*1.5",
					"pony_doomerpuff_smoke2.visible": "between(var.smoke, 0.015, 7)",
					"pony_doomerpuff_smoke3.rx": "pony_doomerpuff_smoke1.rx",
					"pony_doomerpuff_smoke3.ry": "pony_doomerpuff_smoke1.ry",
					"pony_doomerpuff_smoke3.tx": "-var.smoke/-4",
					"pony_doomerpuff_smoke3.ty": "-var.smoke*2",
					"pony_doomerpuff_smoke3.tz": "-var.smoke*2.5",
					"pony_doomerpuff_smoke3.visible": "between(var.smoke, 0.015, 5.5)",
					"pony_doomerpuff_smoke4.rx": "pony_doomerpuff_smoke1.rx",
					"pony_doomerpuff_smoke4.ry": "pony_doomerpuff_smoke1.ry",
					"pony_doomerpuff_smoke4.tx": "-var.smoke/3",
					"pony_doomerpuff_smoke4.ty": "-var.smoke*2.5",
					"pony_doomerpuff_smoke4.tz": "-var.smoke*2.25",
					"pony_doomerpuff_smoke4.visible": "between(var.smoke, 0.015, 7.5)"
				},
				{
					"pony_doomerpuff.rx": "if(is_in_gui, -sin(var.time/12) * torad(26), lerp(var.ponypuff_water, 0, -torad(6)))",
					"pony_doomerpuff.rz": "if(is_in_gui, +cos(var.time/12) * torad(26), 0)",
					"pony_doomerpuff.tx": "+cos(var.damage)*2 -2.5",
					"pony_doomerpuff.ty": "var.fainted*1.5 +lerp(var.ponypuff_water, 0, -8 -sin(var.time/7.5) * torad(16))",
					"pony_doomerpuff_neck.rx": "torad(18.5) -sin(var.time/7.5) * torad(3) + var.inhale2 * sin(time*4)/128",
					"pony_doomerpuff_neck.ry": "var.inhale2 * sin(time*4+pi/4)/128",
					"pony_doomerpuff_neck.rz": "var.inhale2 * sin(time*4+pi/2)/128",
					"pony_doomerpuff_body.ry": "torad(head_yaw)/3 +lerp(var.ponypuff_water, +(sin(limb_swing*2) * limb_speed)/12, 0)",
					"pony_doomerpuff_body.ty": "-13 +lerp(var.ponypuff_water, +lerp(var.ponypuff_rid, 0, -9), 0)",
					"pony_doomerpuff_legs.ry": "torad(head_yaw)/4",
					"pony_doomerpuff_legs.ty": "-8 +lerp(var.ponypuff_water, +lerp(var.ponypuff_rid, 0, -8), 0)",
					"pony_doomerpuff_legs.sy": "1 +lerp(var.ponypuff_water, +lerp(var.ponypuff_rid,  0, 1), 0)",
					"pony_doomerpuff_tail.rx": "torad(17.5) +lerp(var.ponypuff_water, +limb_speed * torad(38) +(cos(limb_swing*2) * limb_speed)/6 , 0)",
					"pony_doomerpuff_tail.rz": "torad(head_yaw)/8 +lerp(var.ponypuff_water, -(sin(limb_swing*2) * limb_speed)/6 , 0)"
				},
				{
					"pony_doomerpuff_leftleg.sy": "      if(is_in_gui, 2   +sin(var.time/12) * 1, 1)",
					"pony_doomerpuff_rightleg.sy": "     if(is_in_gui, 1.5 +cos(var.time/12) * 1, 1)",
					"pony_doomerpuff_leftbackleg.sy": "  if(is_in_gui, 1.5 -sin(var.time/12) * 1, 1)",
					"pony_doomerpuff_rightbackleg.sy": " if(is_in_gui, 1.5 -cos(var.time/12) * 1, 1)",
					"pony_doomerpuff_leftbackleg.tx": "  +3.5 +torad(head_yaw)/6",
					"pony_doomerpuff_rightbackleg.tx": " -2.5 +torad(head_yaw)/6",
					"pony_doomerpuff_leftleg.rx": "      lerp(var.ponypuff_water, +(sin(limb_swing*4) * limb_speed)/1.5, -torad(32))",
					"pony_doomerpuff_rightleg.rx": "     lerp(var.ponypuff_water, -(sin(limb_swing*4) * limb_speed)/1.5, -torad(32))",
					"pony_doomerpuff_leftbackleg.rx": "  lerp(var.ponypuff_water, -(sin(limb_swing*4) * limb_speed)/1.5, +torad(38))",
					"pony_doomerpuff_rightbackleg.rx": " lerp(var.ponypuff_water, +(sin(limb_swing*4) * limb_speed)/1.5, +torad(38))",
					"pony_doomerpuff_leftleg.rz": "      -torad(head_yaw)/8 +if(is_in_gui, -torad(34) +sin(var.time/12) * torad(26), lerp(var.ponypuff_water, 0, -torad(12)))",
					"pony_doomerpuff_rightleg.rz": "     -torad(head_yaw)/8 +if(is_in_gui, +torad(34) -cos(var.time/12) * torad(26), lerp(var.ponypuff_water, 0,  torad(12)))",
					"pony_doomerpuff_leftbackleg.rz": "  +torad(head_yaw)/8 +if(is_in_gui, -torad(34) +cos(var.time/12) * torad(26), lerp(var.ponypuff_water, 0, -torad(11)))",
					"pony_doomerpuff_rightbackleg.rz": " +torad(head_yaw)/8 +if(is_in_gui, +torad(34) -sin(var.time/12) * torad(26), lerp(var.ponypuff_water, 0,  torad(11)))"
				},
				{
					"var.floor": "floor(var.time / 6) % 2",
					"pony_doomerpuff_fog.visible": " var.floor == 0 && var.inhale==0",
					"pony_doomerpuff_fog2.visible": "var.floor == 1 && var.inhale==0",
					"doomerpuff_fog.visible": "pony_doomerpuff_fog.visible",
					"doomerpuff_fog2.visible": "pony_doomerpuff_fog2.visible",
					"pony_doomerpuff_fog.rx": "if(is_in_gui, 0, -player_rot_x)",
					"pony_doomerpuff_fog.ry": "if(is_in_gui, +torad(18), player_rot_y-rot_y+pi +torad(16))",
					"pony_doomerpuff_fog2.rx": "pony_doomerpuff_fog.rx",
					"pony_doomerpuff_fog2.ry": "pony_doomerpuff_fog.ry",
					"pony_doomerpuff_cube.sx": "1 -sin(var.time/7.5) * 0.1 -var.inhale/2",
					"pony_doomerpuff_cube.sy": "1 -cos(var.time/7.5) * 0.1 +var.inhale",
					"pony_doomerpuff_cube.sz": "1 -cos(var.time/7.5) * 0.1 +var.inhale",
					"doomerpuff_cube.sx": "1 -cos(var.time/7.5) * 0.1",
					"doomerpuff_cube.sy": "1 -sin(var.time/7.5) * 0.1",
					"doomerpuff_cube.sz": "1 -sin(var.time/7.5) * 0.1"
				},
				{
					"doomerpuff.ty": "lerp(var.doomerpuff_water, 12, -6.5)",
					"doomerpuff.sx": "lerp(var.doomerpuff_st, 0, 1 +cos(var.time/7.5) * 0.1)",
					"doomerpuff.sy": "lerp(var.doomerpuff_st, 0, 1 +sin(var.time/7.5) * 0.1)",
					"doomerpuff.sz": "lerp(var.doomerpuff_st, 0, 1 +cos(var.time/7.5) * 0.1)",
					"doomerpuff.rx": "-torad(16)",
					"doomerpuff_hair.rx": "torad(84) +cos(var.time/7.5) * torad(8)",
					"doomerpuff.visible": "between(var.ingui, 1, 1)"
				}
			]
		},
