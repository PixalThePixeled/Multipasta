									"boxes": [
										{"coordinates": [-6, 9, -4, 12, 9, 8], "textureOffset": [0, 57], "sizeAdd": 0.6},
										{"coordinates": [-6, -1, -4, 12, 19, 8], "textureOffset": [0, 30]}
									],
									"submodels": [
										{
											"id": "moth_head",
