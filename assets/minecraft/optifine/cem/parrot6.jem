											"translate": [-6, 8, 0],
											"boxes": [
												{"coordinates": [-8, -17, 0, 8, 30, 0], "textureOffset": [24, 0]}
											],
											"submodels": [
												{
													"id": "moth_rightwing_other",
													"invertAxis": "xy",
													"translate": [-8, 0, 0.001],
													"boxes": [
														{"coordinates": [-12, -17, -0.001, 12, 30, 0], "textureOffset": [40, 12]}
													]
												}
											]
										}
									]
								},
								{
									"id": "moth_leftleg",
									"invertAxis": "xy",
									"translate": [3.3, -3, 0],
									"boxes": [
										{"coordinates": [-2.5, -7, -2, 5, 8, 4], "textureOffset": [54, 0]},
										{"coordinates": [-2.5, -7, -4, 7, 0, 6], "textureOffset": [34, 0]}
									]
								},
								{
									"id": "moth_rightleg",
									"invertAxis": "xy",
									"mirrorTexture": "u",
									"translate": [-3.3, -3, 0],
									"boxes": [
										{"coordinates": [-2.5, -7, -2, 5, 8, 4], "textureOffset": [54, 0]},
										{"coordinates": [-4.5, -7, -4, 7, 0, 6], "textureOffset": [34, 0]}
									]
								}
							]
						}
					]
				}
			]
		},
		{
			"part": "left_wing",
			"id": "left_wing",
			"invertAxis": "xy",
			"translate": [1.5, -7.1, 0.8]
		},
