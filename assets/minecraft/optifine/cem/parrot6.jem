{
	"credit": "Model & Texture by Primal, Animations by kotisimo",
	"texture": "textures/entity/multipasta/mothman/mothman.png",
	"textureSize": [128, 128],
	"models": [
		{
			"part": "head",
			"id": "head",
			"invertAxis": "xy",
			"translate": [0, -8, 0.5],
			"animations": [
				{
					"var.time": "time - pi/random(id)",
					"body.rx": 0,
					"body.tx": 0,
					"body.ty": 16.5,
					"body.tz": 0,
					"rotation.rz": "if(death_time > 0, -torad(min(sqrt((death_time - 1) / 20 * 1.6), 1) * 90), 0)",
					"var.mothman_shoulder": "todeg(sin(torad(clamp(if(is_on_shoulder, var.mothman_shoulder-0.03 * frame_time * 20, var.mothman_shoulder+0.05 * frame_time * 20), 0, 1))))",
					"var.mothman_fly": "todeg(sin(torad(clamp(if(is_on_ground && !is_on_shoulder, var.mothman_fly-0.05 * frame_time * 20, var.mothman_fly+0.08 * frame_time * 20), 0, 1))))",
					"var.mothman_sit": "todeg(sin(torad(clamp(if(is_sitting || is_riding, var.mothman_sit-0.55 * frame_time * 20, var.mothman_sit+0.4 * frame_time * 20), 0, 1))))",
					"var.limb_swing": "limb_swing*1.5",
					"var.limb_speed": "limb_speed*8.5"
				},
				{
					"mothman.ty": "if(is_riding, -0.5, lerp(var.mothman_sit, +3.5, -2.5) +lerp(var.mothman_fly, 0, -1.5 -cos(var.time/4) * 2.5)  ) -lerp(var.mothman_shoulder, 6, 0)",
					"mothman.tz": "lerp(var.mothman_shoulder, 24, 0)",
					"mothman.rx": "if(is_riding, -torad(28) , 0) +lerp(var.mothman_fly, 0, torad(8) -cos(var.time/4) * torad(8))",
					"mothman.ry": "if(is_riding, 0, torad(head_yaw/2))",
					"moth_body.ty": "+lerp(var.mothman_fly, 2 +(( sin(var.limb_swing)/4)+torad(1.5)) *var.limb_speed*1.3, 2)",
					"moth_body.rz": "+lerp(var.mothman_fly, -sin(var.time/8) * torad(3), 0)",
					"moth_head.rx": "if(is_riding, 0, torad(max(head_pitch,-15))) +lerp(var.mothman_fly, 0, +0.1 -sin(var.time/4) * torad(8))",
					"moth_head.ry": "if(is_riding, 0, torad(head_yaw/2))",
					"moth_head.rz": "if(is_riding, 0, torad(head_yaw/5)) +lerp(var.mothman_fly, +cos(var.time/8) * torad(3), 0)",
					"moth_leftleg.ty": "if(is_sitting || is_riding, 2, 3) +lerp(var.mothman_fly, min(0, (sin(var.limb_swing+pi/2)+0.3)*var.limb_speed*1.5), 0 )",
					"moth_leftleg.tz": "if(is_sitting || is_riding, -4, 0)",
					"moth_rightleg.ty": "if(is_sitting || is_riding, 2, 3) +lerp(var.mothman_fly, min(0, (-sin(var.limb_swing+pi/2)+0.3)*var.limb_speed*1.5), 0 )",
					"moth_rightleg.tz": "moth_leftleg.tz",
					"moth_leftleg.rx": "if(is_sitting || is_riding, torad(-90), 0) +lerp(var.mothman_fly, (( sin(var.limb_swing)/6)) *var.limb_speed/2, -0.1 -sin(var.time/4) * torad(8))",
					"moth_leftleg.ry": "if(is_sitting || is_riding, torad(10), 0) +lerp(var.mothman_fly, if(is_riding, 0, max(0, torad(head_yaw/3.5))), +0.1 -sin(var.time/4) * torad(8))",
					"moth_rightleg.rx": "if(is_sitting || is_riding, torad(-90), 0) +lerp(var.mothman_fly, (( -sin(var.limb_swing)/6)) *var.limb_speed/2, -0.1 -sin(var.time/4) * torad(8))",
					"moth_rightleg.ry": "if(is_sitting || is_riding, -torad(10), 0) +lerp(var.mothman_fly, if(is_riding, 0, min(0, torad(head_yaw/3.5))), -0.1 +sin(var.time/4) * torad(8))",
					"moth_leftwing.tz": "lerp(var.mothman_fly, +0.5, +sin(var.time/4) * torad(80))",
					"moth_leftwing.rz": "lerp(var.mothman_fly, +(( cos(var.limb_swing)/6)+torad(12)) *var.limb_speed/6.5, +sin(var.time/4) * torad(10))",
					"moth_leftwing.ry": "lerp(var.mothman_fly, -0.7, -0.3 -cos(var.time/4) * torad(40))",
					"moth_leftwing_other.ry": "lerp(var.mothman_fly, -2, -0.07 -cos(var.time/4) * torad(40))",
					"moth_rightwing.tz": "+moth_leftwing.tz",
					"moth_rightwing.rz": "-moth_leftwing.rz",
					"moth_rightwing.ry": "-moth_leftwing.ry",
					"moth_rightwing_other.ry": "-moth_leftwing_other.ry"
				}
			]
		},
		{
			"part": "body",
			"id": "body",
			"invertAxis": "xy",
			"translate": [0, -7.5, 1],
			"submodels": [
