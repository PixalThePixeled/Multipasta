{
	"credit": "Model, Texture & Animations by kotisimo",
	"textureSize": [256, 64],
	"texture": "textures/entity/multipasta/notmogueras_consilium.png",
	"models": [
		{
			"part": "head",
			"id": "head",
			"invertAxis": "xy",
			"translate": [0, -8, 0.5],
			"animations": [
				{
					"var.time": "time - pi/random(id)",
					"body.rx": 0,
					"body.tx": 0,
					"body.ty": 16.5,
					"body.tz": 0,
					"rotation.rz": "if(death_time > 0, -torad(min(sqrt((death_time - 1) / 20 * 1.6), 1) * 90), 0)",
					"var.dance": "                todeg(sin(torad(clamp(if(right_leg.rz!=0&&is_on_ground, var.dance-0.15 * frame_time * 20, var.dance+0.15 * frame_time * 20), 0, 1))))",
					"var.notmoguera_shoulder": "  todeg(sin(torad(clamp(if(is_on_shoulder, var.notmoguera_shoulder-0.035 * frame_time * 20, var.notmoguera_shoulder+0.07 * frame_time * 20), 0, 1))))",
					"var.notmoguera_ground": "    todeg(sin(torad(clamp(if(is_on_ground || is_riding, var.notmoguera_ground-0.1 * frame_time * 20, var.notmoguera_ground+0.08 * frame_time * 20), 0, 1))))",
					"var.notmoguera_groundtail": "todeg(sin(torad(clamp(if(is_on_ground || is_riding, var.notmoguera_groundtail-0.18 * frame_time * 20, var.notmoguera_groundtail+0.07 * frame_time * 20), 0, 1))))",
					"var.notmoguera_sit": "       todeg(sin(torad(clamp(if(is_sitting||is_riding && !is_on_shoulder, var.notmoguera_sit-0.09 * frame_time * 20, var.notmoguera_sit+0.08 * frame_time * 20), 0, 1))))"
				},
				{
					"notmoguera.ty": "            lerp(var.dance, -19.5 -(pow(sin(var.time/1.75), 1)*2),                     lerp(var.notmoguera_ground, -16.5 -pow(sin(time/16), 4)*4 +lerp(var.notmoguera_sit, +7.4 +torad(44) -pow(sin(time/16), 4)*4, -2), -12)      )",
					"notmoguera.tz": "            lerp(var.dance, +2,                                                        lerp(var.notmoguera_shoulder, +24, +2)      )",
					"notmoguera.rx": "            lerp(var.dance, 0,                                                         lerp(var.notmoguera_ground, -torad(6) +lerp(var.notmoguera_sit, -torad(8.5), 0), -torad(0)) +if(is_riding, 0, +torad(head_pitch/2))      )",
					"notmoguera.rz": "            lerp(var.dance, 0,                  if(is_riding, 0, -torad(head_yaw/4))      )",
					"notmoguera.ry": "            lerp(var.dance, 0,                  if(is_riding, 0, torad(head_yaw/2))      )",
					"notmoguera_body.rx": "       lerp(var.dance, 0,                  -torad(2) * hurt_time      )",
					"notmoguera_body.ry": "       lerp(var.dance, -cos(var.time/3.5+pi/1.8) * torad(10) +torad(head_yaw/4),                  0     )",
					"notmoguera_body.rz": "       lerp(var.dance, -sin(var.time/3.5+pi/1.8) * torad(8) -torad(head_yaw/6),   lerp(var.notmoguera_sit, 0, +sin(time/4) * torad(3.5))      )",
					"notmoguera_head.rx": "       lerp(var.dance, +torad(6.5),                  +torad(6.5) +pow(sin(time/8+pi/3),1)/8 -torad(8) * hurt_time +lerp(var.notmoguera_sit, torad(10) +if(is_riding, 0, torad(head_pitch/2)) +pow(sin(time/8+pi/3.7),1)/7, 0 +torad(head_pitch/2))      )",
					"notmoguera_head.ry": "       lerp(var.dance, +cos(var.time/3.5+pi/1.3) * torad(10) +torad(head_yaw/2),          if(is_riding, 0, torad(head_yaw/2))      )",
					"notmoguera_head.rz": "       lerp(var.dance, +sin(var.time/3.5+pi/1.8) * torad(6) +torad(head_yaw/4),   lerp(var.notmoguera_sit, +if(is_riding, 0, +torad(head_yaw/4)), -cos(time/4) * torad(3.5))      )",
					"notmoguera_head.tx": "       lerp(var.dance, 0,                                                         lerp(var.notmoguera_sit, 0, 0 +sin(time/4) * torad(7))      )",
					"notmoguera_head.ty": "       lerp(var.dance, 0,       -(0.15 * hurt_time)      ) -8.9",
					"notmoguera_drillhead.rz": "  lerp(var.dance, 0,        (hurt_time *torad(64))  )",
					"notmoguera_drillhead.tz": "  lerp(var.dance, 0,       -(0.55 * hurt_time)      ) +3.1",
					"notmoguera_drillspring.sz": "lerp(var.dance, 0,        (0.15 * hurt_time)      ) +1",
					"notmoguera_drill.tz": "      lerp(var.dance, 0,       -(1.2 * hurt_time)       ) -7"
				},
				{
					"var.alive": "if(is_alive, 0, 1)",
					"notmoguera_explosions.visible": "between(var.alive, 1, 1)",
					"notmoguera_explosions.ty": "1",
					"notmoguera_explosions.tz": "-2",
					"notmoguera_explosions.rx": "-player_rot_x",
					"notmoguera_explosions.ry": "player_rot_y-rot_y+pi"
				},
				{
					"notmoguera_hand_left_rotation.rx": "lerp(var.dance, +torad(12),                lerp(var.notmoguera_ground, +torad(12) +lerp(var.notmoguera_sit, +torad(16) +pow(sin(time/8), 1)/7.5, -torad(0)), +torad(6.5))      )",
					"notmoguera_hand_left_rotation.ry": "lerp(var.dance, -torad(28),               -torad(28)      )",
					"notmoguera_hand_left_thing_rotation.rx": "lerp(var.dance, 0,                   lerp(var.notmoguera_ground, +torad(0) +lerp(var.notmoguera_sit, +torad(6) -pow(sin(time/8+pi/3),1)/8, -torad(0)), +torad(0))      )",
					"notmoguera_hand_left_thing.rx": "   lerp(var.dance, +torad(5),                 lerp(var.notmoguera_ground, +torad(6) +lerp(var.notmoguera_sit, -torad(6) -pow(sin(time/8+pi/3),1)/6, -torad(0)), +torad(6))      )",
					"notmoguera_hand_left_thing.rz": "   lerp(var.dance, +torad(6),                 if(is_sitting, +torad(4), +torad(6))      )",
					"notmoguera_hand_right_rotation.rx": "notmoguera_hand_left_rotation.rx",
					"notmoguera_hand_right_rotation.ry": "-notmoguera_hand_left_rotation.ry",
					"notmoguera_hand_right_thing_rotation.rx": "notmoguera_hand_left_thing_rotation.rx",
					"notmoguera_hand_right_thing.rx": "notmoguera_hand_left_thing.rx",
					"notmoguera_hand_right_thing.rz": "-notmoguera_hand_left_thing.rz",
					"notmoguera_left_weaponry.rz": "     lerp(var.dance, -torad(45) -(time/1),                 if(round(age/20) % 35 < 30, -torad(45), -torad(45) -(time/1))      )",
					"notmoguera_right_weaponry.rz": "-notmoguera_left_weaponry.rz",
					"notmoguera_tentacle_left.rx": "     lerp(var.dance, -torad(32),                 lerp(var.notmoguera_sit, +torad(44) -pow(sin(time/16), 4)/2, -torad(head_pitch)) -sin(time/6) * torad(14)      )",
					"notmoguera_tentacle_left.ry": "     lerp(var.dance, torad(10),                  0      )",
					"notmoguera_tentacle_left.rz": "     lerp(var.dance, -torad(62) +(pow(sin(var.time/3.5+pi/2), 2)/1.5),                 -torad(12) * hurt_time +lerp(var.notmoguera_ground, -torad(32) -cos(time/6) * torad(14) +if(is_riding, 0, torad(head_pitch/2)) +lerp(var.notmoguera_sit, +if(is_riding, 0, torad(head_pitch)) -torad(46) +pow(sin(time/16), 4)/2, 0), -torad(26) +torad(head_pitch/2) -pow(sin(time/16), 4)/2)      )",
					"notmoguera_tentacle_right.rx": "notmoguera_tentacle_left.rx",
					"notmoguera_tentacle_right.ry": "-notmoguera_tentacle_left.ry",
					"notmoguera_tentacle_right.rz": "-notmoguera_tentacle_left.rz",
					"notmoguera_tail.tx": "              lerp(var.dance, 0,                          lerp(var.notmoguera_groundtail, 0, +cos(time/1) * torad(42))      )",
					"notmoguera_tail.rx": "              lerp(var.dance, -torad(34),                 -torad(6) * hurt_time +lerp(var.notmoguera_groundtail, -torad(19.5) +pow(sin(time/16), 4)/4 +lerp(var.notmoguera_sit, -torad(25) +pow(sin(time/16), 4)/4, -torad(8)), -torad(6))      )",
					"notmoguera_tail.ry": "              lerp(var.dance, 0,                 if(is_riding, 0, +torad(head_yaw/4))      )",
					"notmoguera_tail.rz": "              lerp(var.dance, -sin(var.time/1.75*2) * torad(12),                 -cos(time/1) * torad(7) +if(is_riding, 0, +torad(head_yaw/2))      )",
					"notmoguera_tail2.rz": "             lerp(var.dance, cos(var.time/1.75*2) * torad(18),                 -cos(time/1) * torad(14)      )",
					"notmoguera_tail2.rx": "             lerp(var.dance, -torad(34),    -torad(4) * hurt_time +lerp(var.notmoguera_groundtail, -torad(24) +lerp(var.notmoguera_sit, -torad(28), -torad(8)), -torad(16))      )",
					"notmoguera_tail3.tx": "             lerp(var.dance, 0,                 cos(time/1) * torad(42)      )",
					"notmoguera_tail3.rz": "             lerp(var.dance, cos(var.time/1.75*2) * torad(32),                 -sin(time/1) * torad(42)      )"
				}
			]
		},
