{
	"credit": "Textures by Moro2610, Model & Animations by Kotisimo",
	"textureSize": [128, 64],
	"texture": "textures/entity/multipasta/pepsiman.png",
	"models": [
		{
			"part": "head",
			"id": "head",
			"invertAxis": "xy",
			"translate": [0, -8, 0.5],
			"animations": [
				{
					"var.time": "time - pi/random(id)",
					"body.rx": 0,
					"body.tx": 0,
					"body.ty": 16.5,
					"body.tz": 0,
					"rotation.rz": "if(death_time > 0, -torad(min(sqrt((death_time - 1) / 20 * 1.6), 1) * 90), 0)",
					"varb.ifdance": "right_leg.rz!=0&&is_on_ground",
					"var.limb_swing_fly": "limb_swing*2",
					"var.limb_speed_fly": "limb_speed*2",
					"var.limb_swing": "limb_swing*1",
					"var.limb_speed": "limb_speed*10",
					"var.death": "death_time",
					"var.skatehide": "if(is_riding || varb.ifdance, 0, 1)",
					"var.dance": "           todeg(sin(torad(clamp(if(varb.ifdance, var.dance-0.09 * frame_time * 20, var.dance+0.085 * frame_time * 20), 0, 1))))",
					"var.riding": "          todeg(sin(torad(clamp(if(is_riding, var.riding-0.08 * frame_time * 20, var.riding+0.09 * frame_time * 20), 0, 1))))",
					"var.riding2": "         todeg(sin(torad(clamp(if(is_riding, var.riding2-0.26 * frame_time * 20, var.riding2+0.44 * frame_time * 20), 0, 1))))",
					"var.pm_stand": "        todeg(sin(torad(clamp(if((is_on_ground || is_sitting) && !is_on_shoulder && is_alive, var.pm_stand-0.12 * frame_time * 20, var.pm_stand+0.15 * frame_time * 20), 0, 1))))",
					"var.pm_sit": "          todeg(sin(torad(clamp(if(is_sitting && !is_on_shoulder, var.pm_sit-0.15 * frame_time * 20, var.pm_sit+0.1 * frame_time * 20), 0, 1))))",
					"var.skate_st": "        todeg(sin(torad(clamp(if((is_on_ground || is_sitting || varb.ifdance) && !is_on_shoulder && is_alive, var.skate_st-0.09 * frame_time * 20, var.skate_st+0.4 * frame_time * 20), 0, 1))))",
					"var.skate_appearalt": " todeg(sin(torad(clamp(if((is_on_ground || is_sitting) && !is_on_shoulder && is_alive, var.skate_appearalt-0.14 * frame_time * 20, var.skate_appearalt+0.3 * frame_time * 20), 0, 1))))",
					"var.skate_appearalt2": "todeg(sin(torad(clamp(if((is_on_ground || is_sitting) && !is_on_shoulder && is_alive, var.skate_appearalt2-0.4 * frame_time * 20, var.skate_appearalt2+0.09 * frame_time * 20), 0, 1))))",
					"var.skate_appear": "    todeg(sin(torad(clamp(if((is_on_ground || is_sitting || varb.ifdance) && !is_on_shoulder && is_alive, var.skate_appear-0.4 * frame_time * 20, var.skate_appear+0.14 * frame_time * 20), 0, 1))))"
				},
				{
					"pepsiman.tx": "           lerp(var.dance, 0,                                                        lerp(var.riding, 0,                                                     lerp(var.pm_stand,    lerp(var.pm_sit, 0,                                                                                                                                                                      0     ),                                                                   0)      )      )",
					"pepsiman.ty": "           lerp(var.dance, +7.7,                                                     lerp(var.riding2, +17.5,                                                if(is_on_shoulder, 2, lerp(var.pm_stand,    lerp(var.pm_sit, +13.5,                                                                                                                                          +8.3    ),                                                             +7.5)  )      )      )",
					"pepsiman.tz": "           lerp(var.dance, -1,                                                       if(is_riding, 2.8,                                                      if(is_on_shoulder, 12, lerp(var.pm_stand,    lerp(var.pm_sit, 4,                                                                                                                                               0     ),                                                                0)  )      )      )",
