{
	"credit": "Model by Kotisimo, Texture by Poolb, Animations by Kotisimo and PixalThePixeled",
	"textureSize": [128, 128],
	"texture": "textures/entity/multipasta/wigglytuff/wigglytuff.png",
	"models": [
		{
			"part": "head",
			"id": "head",
			"invertAxis": "xy",
			"translate": [0, -8, 0.5],
			"animations": [
				{
					"body.rx": 0,
					"body.tx": 0,
					"body.ty": 16.5,
					"body.tz": 0,
					"rotation.rz": "if(death_time > 0, -torad(min(sqrt((death_time - 1) / 20 * 1.6), 1) * 90), 0)"
				},
				{
					"var.state": "if(var.health>=1.2 && var.health<1.5, 1, var.health>=1.5 && var.health<2, 2, var.health>=2, 3, 0)",
					"var.time": "time/(var.state/6+1) - pi/random(id)",
					"var.time2": "time - pi/random(id)",
					"var.dance": "if(right_leg.rz!=0&&is_on_ground, 1, 0)",
					"var.dance_count": "clamp(if(var.dance==1, var.dance_count +0.2*frame_time*20, var.dance_count -0.2*frame_time*20), 0, 1)",
					"var.dance_rev": "  clamp(if(var.dance==1, var.dance_rev   -0.2*frame_time*20, var.dance_rev   +0.2*frame_time*20), 0, 1)",
					"var.base": "clamp(if(is_on_shoulder, 0, if(is_sitting, 0, if(is_on_ground, 0, 0))), 0, 1)",
					"var.shoulder": "clamp(if(is_on_shoulder, var.shoulder +0.01*frame_time*20, var.shoulder -0.01*frame_time*20), 0, 1)",
					"varb.sitting": "is_sitting || is_riding",
					"var.sit": "    clamp(if((is_sitting || is_riding) && var.dance==0, var.sit     +0.3*frame_time*20, var.sit     -0.3*frame_time*20), 0, 1)",
					"var.sit_rev": "clamp(if((is_sitting || is_riding) && var.dance==0, var.sit_rev -0.08*frame_time*20, var.sit_rev +0.08*frame_time*20), 0, 1)",
					"var.health": "max_health/health",
					"var.damage": "cos(var.time/0.26) * hurt_time *0.75",
					"var.fainted": "death_time",
					"var.head_pitch": "if(is_riding, 0, head_pitch)",
					"var.head_yaw": "if(is_riding, 0, head_yaw)"
				},
				{
					"var.ball": "clamp(if(!(is_on_ground || is_riding) || is_on_shoulder, var.ball -0.08*frame_time*20, var.ball +0.08*frame_time*20), 0, 1)",
					"wiggly.visible": "   between(var.ball, 0.9 , 1   )",
					"wiggly2.visible": "  between(var.ball, 0.75, 0.9 )",
					"wiggly3.visible": "  between(var.ball, 0.7 , 0.75)",
					"wiggly4.visible": "  between(var.ball, 0.2 , 0.7 )",
					"pokeball4.visible": "between(var.ball, 0.2 , 1   )",
					"pokeball3.visible": "between(var.ball, 0.15, 0.2 )",
					"pokeball2.visible": "between(var.ball, 0.1 , 0.15)",
					"pokeball1.visible": "between(var.ball, 0.05, 0.1 )",
					"pokeball0.visible": "between(var.ball, 0   , 0.05)",
					"var.wiggly_scale": "1 - pow(1 - var.ball, 3)",
					"wigglytuff.tx": "var.damage + if(var.state==3, if(sin(var.time2/23)>0.97,-1+sin(var.time2/0.26) * torad(77), 0), 0)",
					"wigglytuff.ty": "var.fainted +7.5",
					"wigglytuff.sx": "if(var.wiggly_scale >= 0.5, var.wiggly_scale, 0)",
					"wigglytuff.sy": "pow(wigglytuff.sx, 2)",
					"wigglytuff.sz": "wigglytuff.sx",
					"pokeball.sx": "if(var.wiggly_scale < 0.5, 1 + var.wiggly_scale, 0)",
					"pokeball.sy": "pokeball.sx",
					"pokeball.sz": "pokeball.sx"
				},
				{
					"var.sing_x": "-player_rot_x",
					"var.sing_y": "player_rot_y-rot_y+pi",
					"sing.sx": "if(var.dance==1, 1, if(var.dance==0&&health==6, if(round(age/20) % 185 < 180, 0, 1), 0))",
					"sing.sy": "sing.sx",
					"sing.sz": "sing.sx",
					"sing.ty": "-16 -sin(var.time2/6) * 2",
					"sing.ry": "+sin(var.time2/6) * 2 +(var.time2/6)",
					"sing_note1.tz": "+16 -pow(sin(var.time2/12+pi*2), 2)*6",
					"sing_note1.rz": "-cos(var.time/6) * torad(16)",
					"sing_note1.rx": "-var.sing_x",
					"sing_note1.ry": "-var.sing_y",
					"sing_note2.tx": "-sing_note1.tz",
					"sing_note2.rx": "-var.sing_x -sing_note1.rz",
					"sing_note2.ry": "-var.sing_y",
					"sing_note3.tz": "-sing_note1.tz",
					"sing_note3.rz": "sing_note1.rz",
					"sing_note3.rx": "-var.sing_x",
					"sing_note3.ry": "-var.sing_y",
					"sing_note4.tx": "+sing_note1.tz",
					"sing_note4.rx": "-var.sing_x +sing_note1.rz",
					"sing_note4.ry": "-var.sing_y -torad(180)"
				},
				{
					"var.eyescream": "-sin(var.time2/0.3) * -torad(3)",
					"disabled_left_eye.tx": "var.eyescream-var.head_yaw/90+3.5",
					"disabled_left_eye.ty": "var.eyescream+var.head_pitch/90",
					"disabled_right_eye.tx": "var.eyescream-var.head_yaw/90-3.5",
					"disabled_right_eye.ty": "var.eyescream+var.head_pitch/90"
				},
				{
					"var.dance_speed": "var.time2/3",
					"var.limb_swing": "limb_swing",
					"var.limb_speed": "if(is_hurt, 0, limb_speed*2)",
					"var.speed_rev": "abs(1-min(limb_speed*6, 1))",
					"wiggly_body.rx": "var.dance_count*(-cos(var.dance_speed)/32-torad(2)) +var.speed_rev *var.dance_rev *(-cos(var.time/11)/20+torad(2)) + if(is_riding, 0, torad(var.head_pitch/2))+torad(var.state*2.5)",
					"wiggly_body.ry": "var.dance_count*(-sin(var.dance_speed/2)/8 ) +torad(var.head_yaw/4)",
					"wiggly_body.rz": "var.dance_count*( sin(var.dance_speed/2)/16) +torad(var.head_yaw/4) +var.sit_rev  *sin(var.limb_swing+pi/4) *var.limb_speed/6",
					"wiggly_body.ty": "var.dance_count*(-cos(var.dance_speed)-0.25) +var.sit*2 +var.sit_rev *var.speed_rev *var.dance_rev *if(var.state==0,-cos(var.time/11)-0.25,0) -1.5 +var.sit_rev *var.dance_rev *-pow(sin(var.limb_swing), 2 )*var.limb_speed*2",
					"var.earshiver": "if(sin(var.time2/40)>0.99, +cos(var.time2/0.45) * torad(2), var.a)",
					"wiggly_left_ear.rx": " var.dance_count*(-cos(var.dance_speed-pi/2)/8) +torad(var.head_pitch/4) +var.speed_rev *var.dance_rev *(-cos(var.time/11-pi/2-if(var.state!=0,pi/4,0))/3.5     ) +torad(15)   +var.sit_rev *var.dance_rev *(( cos(var.limb_swing)/2)-torad(70)) *var.limb_speed/2 ",
					"wiggly_right_ear.rx": "var.dance_count*(-cos(var.dance_speed-pi/2)/8) +torad(var.head_pitch/4) +var.speed_rev *var.dance_rev *(-cos(var.time/11-pi/2                        )/3.5     ) +torad(15)   +var.sit_rev *var.dance_rev *(( sin(var.limb_swing)/2)-torad(70)) *var.limb_speed/2 ",
					"wiggly_left_ear.rz": " torad( 10) + if(var.state!=0, var.earshiver, 0) +torad(var.head_yaw/4)",
					"wiggly_right_ear.rz": "torad(-10) +torad(var.head_yaw/4)",
					"wiggly_left_earA.visible": "var.state==0",
					"wiggly_left_earB.visible": "var.state!=0",
					"wiggly_hair.rx": "      var.dance_count*(-cos(var.dance_speed-pi/3)/6          ) +var.speed_rev *var.dance_rev *(-cos(var.time/11-pi/1.5)/5    ) -torad(22.5) +var.sit_rev *      ((-cos(var.limb_swing+pi/4)/2  )-torad(90))*var.limb_speed/2 ",
					"wiggly_hair.rz": "      -torad(var.head_yaw/6)",
					"wiggly_left_hand.rx": " var.dance_count*(-cos(var.dance_speed-pi/4)/6-torad(90)) +var.speed_rev *var.dance_rev *( sin(var.time/11)/5           )",
					"wiggly_right_hand.rx": "var.dance_count*(-cos(var.dance_speed-pi/4)/6-torad(90)) +var.speed_rev *var.dance_rev *( sin(var.time/11)/5           )",
					"wiggly_left_hand.ry": " var.dance_count*( cos(var.dance_speed-pi/4)/8-torad(40))",
					"wiggly_right_hand.ry": "var.dance_count*(-cos(var.dance_speed-pi/4)/8+torad(40))",
					"wiggly_left_hand.rz": " var.dance_rev *-torad(22.5) +var.speed_rev *var.dance_rev *( cos(var.time/11)/5 -torad(15)) +var.sit_rev *      (( cos(var.limb_swing+pi/4)/3  )-torad(90))*var.limb_speed/2 ",
					"wiggly_right_hand.rz": "var.dance_rev *+torad(22.5) +var.speed_rev *var.dance_rev *(-cos(var.time/11)/5 +torad(15))  +var.sit_rev *      ((-cos(var.limb_swing+pi/4)/3  )+torad(90))*var.limb_speed/2",
					"wiggly_left_leg.rx": " var.dance_count*(cos(var.dance_speed)/8+torad(7.5)) +if(varb.sitting && var.dance==0, torad(-70),0) +var.sit_rev *var.dance_rev *var.speed_rev * if(var.state==0,max( cos(var.time/11)/5, 0),0) +var.sit_rev *var.dance_rev *min(0, ( sin(var.limb_swing     )+0.3)           *var.limb_speed/2)",
					"wiggly_right_leg.rx": "var.dance_count*(cos(var.dance_speed)/8+torad(7.5)) +if(varb.sitting && var.dance==0, torad(-70),0) +var.sit_rev *var.dance_rev *var.speed_rev * if(var.state==0,max( cos(var.time/11)/5, 0),0) +var.sit_rev *var.dance_rev *min(0, (-sin(var.limb_swing     )+0.3)           *var.limb_speed/2)",
					"wiggly_left_leg.ry": " if(varb.sitting && var.dance==0, torad(-10),0) +var.speed_rev *var.dance_rev *( cos(var.time/11)/15          ) +torad(-10)               +min(0, torad(var.head_yaw/4))",
					"wiggly_right_leg.ry": "if(varb.sitting && var.dance==0, torad( 10),0) +var.speed_rev *var.dance_rev *(-cos(var.time/11)/15          ) +torad( 10)               +max(0, torad(var.head_yaw/4))",
					"wiggly_left_leg.rz": " if(varb.sitting && var.dance==0, torad( 15),0)",
					"wiggly_right_leg.rz": "if(varb.sitting && var.dance==0, torad(-15),0)",
					"wiggly_left_leg.tx": " if(varb.sitting && var.dance==0,  1 -torad(var.head_yaw), 0)+3",
					"wiggly_right_leg.tx": "if(varb.sitting && var.dance==0, -1 -torad(var.head_yaw), 0)-3",
					"wiggly_left_leg.ty": " var.dance_count*min(-cos(var.dance_speed)*1.25-1, 2) +if(varb.sitting && var.dance==0,  3.5   +torad(var.head_pitch*2),0)+var.sit_rev *var.dance_rev *var.speed_rev * if(var.state==0,min(-cos(var.time/11)*2, 0),0)              +var.sit_rev *min(0, ( sin(var.limb_swing)+0.3)*var.limb_speed*2) -1",
					"wiggly_right_leg.ty": "var.dance_count*min(-cos(var.dance_speed)*1.25-1, 2) +if(varb.sitting && var.dance==0,  3.5   +torad(var.head_pitch*2),0)+var.sit_rev *var.dance_rev *var.speed_rev * if(var.state==0,min(-cos(var.time/11)*2, 0),0)              +var.sit_rev *min(0, (-sin(var.limb_swing)+0.3)*var.limb_speed*2) -1",
					"wiggly_left_leg.tz": " if(varb.sitting && var.dance==0, -8.5 -torad(var.head_pitch*2)-torad(var.head_yaw),0) +var.sit_rev *sin(var.limb_swing-pi/2)*var.limb_speed*3 +3",
					"wiggly_right_leg.tz": "if(varb.sitting && var.dance==0, -8.5 -torad(var.head_pitch*2)+torad(var.head_yaw),0) +var.sit_rev *sin(var.limb_swing+pi/2)*var.limb_speed*3 +3",
					"disabled_eyes.visible": "var.health>=3"
				},
